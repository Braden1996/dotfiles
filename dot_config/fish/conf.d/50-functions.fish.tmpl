function yazi_choose
    set -l tmpfile (mktemp)
    yazi --chooser-file="$tmpfile" >/dev/tty

    if test -s "$tmpfile"
        set -l selection (cat "$tmpfile")
        commandline --insert -- (string escape -- $selection)
    end

    rm -f "$tmpfile"
    commandline -f repaint
end

function yazi_cd
    set -l tmpfile (mktemp)
    yazi --chooser-file="$tmpfile" >/dev/tty

    if test -s "$tmpfile"
        set -l selection (cat "$tmpfile")
        if test -d "$selection"
            cd "$selection"
        end
    end

    rm -f "$tmpfile"
    commandline -f repaint
end

function __braden_nx_is_workspace_root --argument-names dir
    test -n "$dir"; or return 1
    test -f "$dir/nx.json"; and return 0
    test -x "$dir/node_modules/.bin/nx"
end

function __braden_nx_find_workspace_root --argument-names start_dir
    test -n "$start_dir"; or return 1

    set -l dir (path resolve "$start_dir" 2>/dev/null)
    or set dir "$start_dir"

    while true
        if __braden_nx_is_workspace_root "$dir"
            echo "$dir"
            return 0
        end

        if test "$dir" = "/"
            return 1
        end

        set dir (path dirname "$dir")
    end
end

function __braden_nx_workspace_root
    set -l workspace_root (__braden_nx_find_workspace_root "$PWD")
    if test -n "$workspace_root"
        echo "$workspace_root"
        return 0
    end

    if set -q BRADEN_NX_DEFAULT_WORKSPACE
        set -l default_workspace (path resolve "$BRADEN_NX_DEFAULT_WORKSPACE" 2>/dev/null)
        or set default_workspace "$BRADEN_NX_DEFAULT_WORKSPACE"

        if __braden_nx_is_workspace_root "$default_workspace"
            echo "$default_workspace"
            return 0
        end
    end

    return 1
end

function __braden_nx_local_bin --argument-names workspace_root
    test -n "$workspace_root"; or return 1

    set -l nx_bin "$workspace_root/node_modules/.bin/nx"
    test -x "$nx_bin"; or return 1

    echo "$nx_bin"
end

function nx
    set -l workspace_root (__braden_nx_workspace_root)

    if test -z "$workspace_root"
        if command -q nx
            command nx $argv
            return $status
        end

        echo "No Nx workspace found from $PWD. Set BRADEN_NX_DEFAULT_WORKSPACE to enable nx outside a repo." >&2
        return 1
    end

    set -l nx_bin (__braden_nx_local_bin "$workspace_root")
    if test -z "$nx_bin"
        echo "nx is not available at $workspace_root/node_modules/.bin/nx" >&2
        return 1
    end

    if command -q mise
        mise exec -C "$workspace_root" -- "$nx_bin" $argv
    else
        env PATH="$PATH" HOME="$HOME" bash -c '
            cd "$1" || exit 1
            shift
            "$@"
        ' bash "$workspace_root" "$nx_bin" $argv
    end
end

function fish-check-deps
    set -l required starship fzf mise
    set -l optional eza bat yazi zoxide
    set -l missing_required
    set -l missing_optional

    for cmd in $required
        command -q $cmd; or set -a missing_required $cmd
    end

    for cmd in $optional
        command -q $cmd; or set -a missing_optional $cmd
    end

    if test (count $missing_required) -gt 0
        set_color red
        echo "[fish] Missing required: "(string join ", " -- $missing_required)
        set_color yellow
        echo "  brew install "(string join " " -- $missing_required)
        set_color normal
    else
        set_color green
        echo "All required dependencies installed"
        set_color normal
    end

    if test (count $missing_optional) -gt 0
        set_color brblack
        echo "[fish] Optional: "(string join ", " -- $missing_optional)" (brew install "(string join " " -- $missing_optional)")"
        set_color normal
    end
end

function __braden_magic_enter
    set -l buffer (string trim -- (commandline))

    if test -n "$buffer"
        commandline -f execute
        return
    end

    if git rev-parse --is-inside-work-tree >/dev/null 2>/dev/null
        commandline --replace -- "git status -u ."
    else if command -q eza
        commandline --replace -- "eza -Gax --icons=always --group-directories-first --git"
    else
        commandline --replace -- "ls -lh ."
    end

    commandline -f execute
end

function __braden_toggle_sudo
    set -l buffer (commandline)

    if test -z "$buffer"
        set buffer (history --max=1)
    end

    if string match -qr '^sudo ' -- $buffer
        commandline --replace -- (string replace -r '^sudo ' '' -- $buffer)
    else
        commandline --replace -- "sudo $buffer"
    end

    commandline -f repaint
end

function __braden_fzf_history
    if not command -q fzf
        commandline -f up-line
        return
    end

    set -l selection (history --max=2000 | fzf \
        --scheme=history \
        --tac \
        --no-sort \
        --query=(commandline))

    if test -n "$selection"
        commandline --replace -- $selection
    end

    commandline -f repaint
end

function __braden_clear_startup_time --on-event fish_preexec
    set -e ZSH_STARTUP_MS
    functions -e __braden_clear_startup_time
end

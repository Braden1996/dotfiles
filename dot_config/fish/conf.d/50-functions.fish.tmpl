function __braden_print_safe_chain_warning --argument-names original_cmd
    if set -q __BRADEN_SAFE_CHAIN_WARNED
        return
    end

    set -g __BRADEN_SAFE_CHAIN_WARNED 1

    set_color -b yellow black
    printf "Warning:"
    set_color normal
    printf " safe-chain is not available to protect you from installing malware. %s will run without it.\n" $original_cmd
    printf "Install safe-chain by using "
    set_color cyan
    printf "npm install -g @aikidosec/safe-chain"
    set_color normal
    printf ".\n"
end

function __braden_safe_chain_exec --argument-names original_cmd
    set -l cmd_args $argv[2..-1]

    if command -q safe-chain
        safe-chain $original_cmd $cmd_args
    else
        __braden_print_safe_chain_warning $original_cmd
        command $original_cmd $cmd_args
    end
end

function npm
    if test (count $argv) -eq 1
        switch $argv[1]
            case -v --version
                command npm $argv
                return
        end
    end

    __braden_safe_chain_exec npm $argv
end


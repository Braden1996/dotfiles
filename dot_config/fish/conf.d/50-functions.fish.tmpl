function yazi_choose
    set -l tmpfile (mktemp)
    yazi --chooser-file="$tmpfile" >/dev/tty

    if test -s "$tmpfile"
        set -l selection (cat "$tmpfile")
        commandline --insert -- (string escape -- $selection)
    end

    rm -f "$tmpfile"
    commandline -f repaint
end

function yazi_cd
    set -l tmpfile (mktemp)
    yazi --chooser-file="$tmpfile" >/dev/tty

    if test -s "$tmpfile"
        set -l selection (cat "$tmpfile")
        if test -d "$selection"
            cd "$selection"
        end
    end

    rm -f "$tmpfile"
    commandline -f repaint
end

function nx
    set -l phoenix_root "{{ .chezmoi.homeDir }}/Development/Phoenix"
    set -l nx_bin "$phoenix_root/node_modules/.bin/nx"

    if not test -x "$nx_bin"
        echo "nx is not available at $nx_bin" >&2
        return 1
    end

    if string match -q -- "$phoenix_root*" "$PWD"
        "$nx_bin" $argv
    else
        env PATH="$PATH" HOME="$HOME" bash -c '
            cd "$1" || exit 1
            shift
            "$@"
        ' bash "$phoenix_root" "$nx_bin" $argv
    end
end

function fish-check-deps
    set -l required starship fzf mise
    set -l optional eza bat yazi zoxide
    set -l missing_required
    set -l missing_optional

    for cmd in $required
        command -q $cmd; or set -a missing_required $cmd
    end

    for cmd in $optional
        command -q $cmd; or set -a missing_optional $cmd
    end

    if test (count $missing_required) -gt 0
        set_color red
        echo "[fish] Missing required: "(string join ", " -- $missing_required)
        set_color yellow
        echo "  brew install "(string join " " -- $missing_required)
        set_color normal
    else
        set_color green
        echo "All required dependencies installed"
        set_color normal
    end

    if test (count $missing_optional) -gt 0
        set_color brblack
        echo "[fish] Optional: "(string join ", " -- $missing_optional)" (brew install "(string join " " -- $missing_optional)")"
        set_color normal
    end
end

function __braden_magic_enter
    set -l buffer (string trim -- (commandline))

    if test -n "$buffer"
        commandline -f execute
        return
    end

    if git rev-parse --is-inside-work-tree >/dev/null 2>/dev/null
        commandline --replace -- "git status -u ."
    else if command -q eza
        commandline --replace -- "eza -Gax --icons=always --group-directories-first --git"
    else
        commandline --replace -- "ls -lh ."
    end

    commandline -f execute
end

function __braden_toggle_sudo
    set -l buffer (commandline)

    if test -z "$buffer"
        set buffer (history --max=1)
    end

    if string match -qr '^sudo ' -- $buffer
        commandline --replace -- (string replace -r '^sudo ' '' -- $buffer)
    else
        commandline --replace -- "sudo $buffer"
    end

    commandline -f repaint
end

function __braden_fzf_history
    if not command -q fzf
        commandline -f up-line
        return
    end

    set -l selection (history --max=2000 | fzf \
        --scheme=history \
        --tac \
        --no-sort \
        --query=(commandline))

    if test -n "$selection"
        commandline --replace -- $selection
    end

    commandline -f repaint
end

function __braden_clear_startup_time --on-event fish_preexec
    set -e ZSH_STARTUP_MS
    functions -e __braden_clear_startup_time
end

# =============================================================================
# Local Overrides & External Tools
# =============================================================================
# Machine-specific configuration that shouldn't be committed

if (( ${__BRADEN_ZSH_HAS_TTY:-1} )); then
  # Nx completion
  [[ -s "$HOME/.nx-completion/nx-completion.plugin.zsh" ]] && source "$HOME/.nx-completion/nx-completion.plugin.zsh"

  # Bun completions
  [[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"
fi

# 1Password-backed secrets
# To enable 1Password integration, uncomment and adjust the op:// URIs below.
# Requires `op` CLI to be installed and configured.
# export NGROK_AUTHTOKEN="$(op read 'op://Private/ngrok/credential' --account {{ .onePasswordAccount }})"
# Optional: set a default Nx workspace if you want `nx` to work outside a repo.
# export BRADEN_NX_DEFAULT_WORKSPACE="$HOME/Development/Phoenix"

# Safe-chain initialization
[[ -f ~/.safe-chain/scripts/init-posix.sh ]] && source ~/.safe-chain/scripts/init-posix.sh

# Keep package-manager wrappers working when tools are exposed via corepack.
yarn() { __braden_zsh_run_wrapped_command yarn "$@"; }
pnpm() { __braden_zsh_run_wrapped_command pnpm "$@"; }
pnpx() { __braden_zsh_run_wrapped_command pnpx "$@"; }

# Clear startup time after first command so it only shows on the initial prompt.
_clear_startup_time() {
  unset ZSH_STARTUP_MS
  add-zsh-hook -d preexec _clear_startup_time
}
if (( ${__BRADEN_ZSH_HAS_TTY:-1} )); then
  autoload -Uz add-zsh-hook
  add-zsh-hook preexec _clear_startup_time
fi

# =============================================================================
# Final PATH cleanup (deduplicate after all sources)
# =============================================================================
typeset -U path

# =============================================================================
# PATH Configuration
# =============================================================================
# Consolidated PATH modifications. User wrappers and mise-managed runtimes
# intentionally win over standalone and Homebrew installations.
typeset -a __braden_preferred_paths
typeset __braden_path_dir __braden_homebrew_prefix

__braden_homebrew_prefix="${HOMEBREW_PREFIX:-/opt/homebrew}"
[[ -d "$__braden_homebrew_prefix" ]] || __braden_homebrew_prefix=/usr/local

__braden_preferred_paths=()
for __braden_path_dir in \
  "$HOME/.local/bin" \
  "$HOME/.local/share/mise/shims" \
  "$HOME/.bun/bin" \
  "$HOME/.cargo/bin" \
  "$HOME/.antigravity/antigravity/bin" \
{{- if eq .machineType "personal" }}
  "$HOME/.grok/bin" \
  "$HOME/.kimi-code/bin" \
{{- end }}
  "$__braden_homebrew_prefix/bin" \
  "$__braden_homebrew_prefix/sbin" \
  /usr/local/bin
do
  [[ -d "$__braden_path_dir" ]] && __braden_preferred_paths+=("$__braden_path_dir")
done

path=("${__braden_preferred_paths[@]}" $path)
[[ -d "$HOME/Library/Android/sdk/platform-tools" ]] && path+=("$HOME/Library/Android/sdk/platform-tools")
typeset -gaU path
unset __braden_preferred_paths __braden_path_dir __braden_homebrew_prefix

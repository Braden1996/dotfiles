# -----------------------------------------------------------------------------
# Yazi file picker integration
# -----------------------------------------------------------------------------
yazi_choose() {
  local tmpfile="$(mktemp)"
  yazi --chooser-file="$tmpfile" >/dev/tty
  if [[ -f "$tmpfile" && -s "$tmpfile" ]]; then
    LBUFFER+=$(<"$tmpfile")
  fi
  rm -f "$tmpfile"
  zle redisplay
}
zle -N yazi_choose

yazi_cd() {
  local tmpfile="$(mktemp)"
  yazi --chooser-file="$tmpfile" >/dev/tty
  if [[ -f "$tmpfile" && -s "$tmpfile" ]]; then
    local selection=$(<"$tmpfile")
    rm -f "$tmpfile"
    if [[ -d "$selection" ]]; then
      cd "$selection"
      zle reset-prompt
    fi
  else
    rm -f "$tmpfile"
  fi
}
zle -N yazi_cd


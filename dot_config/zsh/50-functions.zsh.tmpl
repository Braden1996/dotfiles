# Dependency check (run manually with: zsh-check-deps)
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Nx workspace wrapper
# -----------------------------------------------------------------------------
__braden_nx_is_workspace_root() {
  [[ -n "$1" ]] || return 1
  [[ -f "$1/nx.json" || -x "$1/node_modules/.bin/nx" ]]
}

__braden_nx_find_workspace_root() {
  local dir="${1:A}"

  while true; do
    if __braden_nx_is_workspace_root "$dir"; then
      print -r -- "$dir"
      return 0
    fi

    [[ "$dir" == "/" ]] && return 1
    dir="${dir:h}"
  done
}

__braden_nx_workspace_root() {
  local workspace_root

  workspace_root="$(__braden_nx_find_workspace_root "$PWD")" && {
    print -r -- "$workspace_root"
    return 0
  }

  if [[ -n "${BRADEN_NX_DEFAULT_WORKSPACE:-}" ]] && __braden_nx_is_workspace_root "$BRADEN_NX_DEFAULT_WORKSPACE"; then
    print -r -- "${BRADEN_NX_DEFAULT_WORKSPACE:A}"
    return 0
  fi

  return 1
}

__braden_nx_local_bin() {
  local workspace_root="$1"
  local nx_bin="$workspace_root/node_modules/.bin/nx"

  [[ -x "$nx_bin" ]] || return 1
  print -r -- "$nx_bin"
}

nx() {
  local workspace_root nx_bin

  workspace_root="$(__braden_nx_workspace_root)" || {
    if (( $+commands[nx] )); then
      command nx "$@"
      return
    fi

    echo "No Nx workspace found from $PWD. Set BRADEN_NX_DEFAULT_WORKSPACE to enable nx outside a repo." >&2
    return 1
  }

  nx_bin="$(__braden_nx_local_bin "$workspace_root")" || {
    echo "nx is not available at $workspace_root/node_modules/.bin/nx" >&2
    return 1
  }

  if (( $+commands[mise] )); then
    mise exec -C "$workspace_root" -- "$nx_bin" "$@"
  else
    (cd "$workspace_root" && "$nx_bin" "$@")
  fi
}

# -----------------------------------------------------------------------------
# Dependency check (run manually with: zsh-check-deps)
# -----------------------------------------------------------------------------
zsh-check-deps() {
  local -a required=(starship fzf mise)
  local -a optional=(eza bat yazi zoxide)
  local -a missing_required=() missing_optional=()
  local antidote_missing=0
  local antidote_homebrew="${HOMEBREW_PREFIX:-/opt/homebrew}/opt/antidote/share/antidote/antidote.zsh"
  local antidote_cache="$ANTIDOTE_HOME/antidote.zsh"

  # Antidote can come from Homebrew or a git clone cache.
  if [[ ! -f "$antidote_homebrew" && ! -f "$antidote_cache" ]]; then
    antidote_missing=1
  fi

  for cmd in $required; do
    command -v $cmd &>/dev/null || missing_required+=($cmd)
  done

  for cmd in $optional; do
    command -v $cmd &>/dev/null || missing_optional+=($cmd)
  done

  if (( antidote_missing )); then
    print -P "%F{red}%B[zshrc]%b Missing required: antidote%f"
    print -P "%F{yellow}  git clone --depth=1 https://github.com/mattmc3/antidote.git \${ANTIDOTE_HOME:-~/.antidote}%f"
  fi

  if (( ${#missing_required} )); then
    print -P "%F{red}%B[zshrc]%b Missing required:%f ${(j:, :)missing_required}"
    print -P "%F{yellow}  brew install ${(j: :)missing_required}%f"
  fi

  if (( !antidote_missing && !${#missing_required} )); then
    print -P "%F{green}All required dependencies installed%f"
  fi

  if (( ${#missing_optional} )); then
    print -P "%F{8}[zshrc] Optional: ${(j:, :)missing_optional} (brew install ${(j: :)missing_optional})%f"
  fi
}

{
  "$schema": "zed://schemas/settings",

  "preview_tabs": {
    "enabled": false
  },
  "vertical_scroll_margin": 8,

  "buffer_font_family": "FiraCode Nerd Font Mono",
  "buffer_font_fallbacks": [
    "Menlo",
    "Monaco",
    "Courier New",
    "monospace"
  ],
  "buffer_font_size": 13.25,
  "ui_font_family": "Atkinson Hyperlegible",
  "ui_font_size": 16.25,
  "terminal": {
    "font_family": "FiraCode Nerd Font Mono",
    "font_fallbacks": [
      "Menlo",
      "Monaco",
      "Courier New",
      "monospace"
    ],
    "font_size": 14
  },

  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Macchiato"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Flow Dim (Light)",
    "dark": "Flow Dim"
  },

  "auto_install_extensions": {
    "html": true,
    "catppuccin": true,
    "catppuccin-blur": false,
    "biome": false
  },

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    }
  },

  "formatter": "auto",
  "languages": {
    "JavaScript": {
      "format_on_save": "on"
    },
    "TypeScript": {
      "format_on_save": "on"
    },
    "TSX": {
      "format_on_save": "on"
    },
    "JSON": {
      "format_on_save": "on"
    },
    "JSONC": {
      "format_on_save": "on"
    },
    "CSS": {
      "format_on_save": "on"
    }
  },
  "semantic_tokens": "combined",
  "colorize_brackets": true,
  "tab_size": 2,
  "preferred_line_length": 120,
  "wrap_guides": [80, 100, 120],

  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors"
  },
  "indent_guides": {
    "coloring": "indent_aware"
  },
  "minimap": {
    "show": "always"
  },
  "sticky_scroll": {
    "enabled": true
  },
  "completion_menu_scrollbar": "system",

  "project_panel": {
    "dock": "right",
    "hide_root": true
  },
  "git_panel": {
    "dock": "left",
    "sort_by": "path",
    "group_by": "status"
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": true
    }
  },
  "title_bar": {
    "show_menus": true,
    "show_branch_status_icon": true
  }
}

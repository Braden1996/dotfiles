# Homebrew Bundle installs missing dependencies only. Upgrades are explicit via
# dotfiles-update so a normal chezmoi apply remains predictable.

## Taps
# Third-party taps are also allowlisted by the package-install hook.
tap "withgraphite/tap"

## Shell and prompt
brew "antidote"
brew "fish"
brew "starship"
brew "zsh"

## Core CLI tools
brew "bat"
brew "chezmoi"
brew "eza"
brew "fd"
brew "fzf"
brew "hyperfine"
brew "jq"
brew "ripgrep"
brew "yazi"
brew "zoxide"

## Credentials
# The CLI is needed on every machine: personal machines use it to create and
# publish the machine keys, work machines to load them into the ssh-agent.
# It is distributed as a cask, not a formula.
cask "1password-cli"

## Development and validation
brew "gh"
brew "git"
brew "git-delta"
brew "gnupg"
brew "mise"
brew "shellcheck"
brew "shfmt"
brew "taplo"
brew "tmux"
brew "withgraphite/tap/graphite"

## Desktop tools
cask "cursor"
cask "font-atkinson-hyperlegible"
cask "font-fira-code-nerd-font"
cask "ghostty"
{{ if ne (or (get . "machineType") "personal") "work" }}
# Only personal machines run the desktop app. Work machines reach 1Password
# through a service account and the CLI alone, which is what keeps their access
# revocable from here.
cask "1password"
{{- end }}

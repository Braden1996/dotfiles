#!/bin/bash
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "Flow Icons premium setup is macOS-only; skipping."
  exit 0
fi

readonly source_dir={{ printf "%s/.local/share/chezmoi-externals/flow-icons-zed" .chezmoi.homeDir | quote }}
readonly extension_dir={{ printf "%s/.local/share/zed-dev-extensions/flow-icons-zed" .chezmoi.homeDir | quote }}
readonly revision_file="$extension_dir/.flow-icons-source-revision"
readonly consent_file={{ printf "%s/.config/flow-icons-zed/premium-network-consent-v1" .chezmoi.homeDir | quote }}
readonly keychain_service="flow-icons-zed-premium"
keychain_account="$(id -un)"
readonly keychain_account

if [[ ! -d "$source_dir/.git" ]] || [[ ! -r "$source_dir/update-icons.cjs" ]]; then
  echo "Flow Icons source external is missing: $source_dir" >&2
  echo "Re-run with: chezmoi apply --refresh-externals" >&2
  exit 1
fi

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js is required to update Flow Icons; install the managed mise tools first." >&2
  exit 1
fi

source_revision="$(git -C "$source_dir" rev-parse --verify HEAD)"
installed_revision=""
if [[ -r "$revision_file" ]]; then
  installed_revision="$(<"$revision_file")"
fi

if [[ "$source_revision" != "$installed_revision" ]] || \
  [[ ! -r "$extension_dir/update-icons.cjs" ]]; then
  mkdir -p "$extension_dir"
  /usr/bin/rsync \
    --archive \
    --delete \
    --exclude '.git/' \
    --exclude 'config.json' \
    "$source_dir/" "$extension_dir/"
  printf '%s\n' "$source_revision" >"$revision_file"
fi

if [[ ! -r "$consent_file" ]]; then
  echo "Flow Icons public assets are ready."
  echo "Premium updates send the license as an Authorization header to"
  echo "https://legit-i9lq.onrender.com/flow-icons and send an MD5-derived hostname identifier."

  if [[ ! -t 0 ]]; then
    echo "Premium update skipped: run chezmoi apply interactively to review and consent."
    exit 0
  fi

  printf 'Allow this network disclosure and remember the choice? [y/N] '
  read -r consent </dev/tty
  case "$consent" in
    y|Y|yes|YES)
      umask 077
      mkdir -p "$(dirname "$consent_file")"
      printf '%s\n' "Approved Flow Icons premium API disclosure v1" >"$consent_file"
      ;;
    *)
      echo "Premium update skipped; public Flow Icons remain installed."
      exit 0
      ;;
  esac
fi

if ! /usr/bin/security find-generic-password \
  -a "$keychain_account" \
  -s "$keychain_service" >/dev/null 2>&1; then
  if [[ ! -t 0 ]]; then
    echo "Flow Icons premium license is not in macOS Keychain." >&2
    echo "Re-run chezmoi apply from an interactive terminal to enter it securely." >&2
    exit 1
  fi

  echo "Flow Icons premium license is not in macOS Keychain."
  echo "Enter it at the secure Keychain prompt; it will not be written to dotfiles."
  /usr/bin/security add-generic-password \
    -U \
    -a "$keychain_account" \
    -s "$keychain_service" \
    -l "Flow Icons Zed Premium" \
    -T /usr/bin/security \
    -w </dev/tty
fi

echo "Checking Flow Icons premium assets..."
(
  cd "$extension_dir"
  /usr/bin/security find-generic-password \
    -a "$keychain_account" \
    -s "$keychain_service" \
    -w |
    node -e '
      const fs = require("node:fs");
      const path = require("node:path");
      const key = fs.readFileSync(0, "utf8").trim();
      if (!key) {
        console.error("Flow Icons license lookup returned no value");
        process.exit(1);
      }
      process.argv[2] = key;
      require(path.join(process.cwd(), "update-icons.cjs"));
    '
)

echo "Flow Icons premium assets are ready in: $extension_dir"
echo "After the first install, Zed may need a restart to reload updated icons."

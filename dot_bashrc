# Keep non-interactive Bash invocations deterministic.
case $- in
  *i*) ;;
  *) return ;;
esac

# Non-login interactive shells do not read ~/.profile themselves.
if ! shopt -q login_shell && [ -r "$HOME/.profile" ]; then
  . "$HOME/.profile"
fi

# Keep history local, append across sessions, and omit space-prefixed commands.
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=50000
HISTFILESIZE=50000
shopt -s histappend

# Safe-chain bash initialization
[[ -f "$HOME/.safe-chain/scripts/init-posix.sh" ]] && source "$HOME/.safe-chain/scripts/init-posix.sh"

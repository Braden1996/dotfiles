#!/bin/bash
# braden-dots app flow-icons module.
set -euo pipefail

MODULE_DIR="$(
  unset CDPATH
  cd -- "$(dirname -- "$0")" && pwd
)"
readonly MODULE_DIR
readonly SOURCE_REVISION={{ .flowIcons.revision | quote }}
readonly SOURCE_DIR={{ printf "%s/.local/share/chezmoi-externals/flow-icons-zed" .chezmoi.homeDir | quote }}
readonly EXTENSION_DIR={{ printf "%s/.local/share/zed-dev-extensions/flow-icons-zed" .chezmoi.homeDir | quote }}
readonly CONSENT_FILE={{ printf "%s/.config/flow-icons-zed/premium-network-consent-v1" .chezmoi.homeDir | quote }}
readonly DOTS_BIN={{ printf "%s/.local/bin/braden-dots" .chezmoi.homeDir | quote }}
readonly SETTINGS_PATCHER="$MODULE_DIR/jsonc-setting.cjs"
readonly VSCODE_SETTINGS={{ printf "%s/Library/Application Support/Code/User/settings.json" .chezmoi.homeDir | quote }}
readonly CURSOR_SETTINGS={{ printf "%s/Library/Application Support/Cursor/User/settings.json" .chezmoi.homeDir | quote }}

usage() {
  cat <<'USAGE'
Usage: braden-dots app flow-icons [--public]

Project the 1Password licence into local-only VS Code and Cursor settings, then
install or refresh the pinned Flow Icons extension for Zed. Zed's premium
download still requires explicit network consent. --public never reads or
projects the licence.
USAGE
}

fail() { printf '[xx] %s\n' "$*" >&2; }
warn() { printf '[!!] %s\n' "$*"; }
note() { printf '[--] %s\n' "$*"; }

public_only=false
case "${1:-}" in
  "") ;;
  --public) public_only=true ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
[[ $# -le 1 ]] || {
  usage >&2
  exit 2
}

if [[ "$(uname -s)" != Darwin ]]; then
  note "Flow Icons setup is macOS-only."
  exit 0
fi
if [[ ! -r "$SOURCE_DIR/update-icons.cjs" ]]; then
  fail "pinned Flow Icons source is missing: $SOURCE_DIR"
  fail "Run: chezmoi apply --refresh-externals"
  exit 1
fi

node_bin="$(command -v node || true)"
if [[ -z "$node_bin" && -x {{ printf "%s/.local/share/mise/shims/node" .chezmoi.homeDir | quote }} ]]; then
  node_bin={{ printf "%s/.local/share/mise/shims/node" .chezmoi.homeDir | quote }}
fi
if [[ -z "$node_bin" ]]; then
  fail "Node.js is required; run the managed mise installation first."
  exit 1
fi
readonly node_bin
if [[ ! -r "$SETTINGS_PATCHER" ]]; then
  fail "Flow Icons settings helper is missing: $SETTINGS_PATCHER"
  exit 1
fi

editor_is_present() {
  local settings=$1 application=$2 command_name=$3
  [[ -f "$settings" || -d "$(dirname "$settings")" || -d "$application" ]] ||
    command -v "$command_name" >/dev/null 2>&1
}

project_editor_license() {
  local editor=$1 settings=$2 application=$3 command_name=$4
  if ! editor_is_present "$settings" "$application" "$command_name"; then
    note "$editor is not installed; skipping its Flow Icons setting."
    return 0
  fi

  if "$DOTS_BIN" secret read flow-icons |
    "$node_bin" "$SETTINGS_PATCHER" set-flow-license "$settings"; then
    printf '[ok] Flow Icons licence projected into %s\n' "$editor"
  else
    fail "could not project the Flow Icons licence into $editor"
    return 1
  fi
}

extension_parent="$(dirname "$EXTENSION_DIR")"
mkdir -p "$extension_parent"
stage_root="$(mktemp -d "$extension_parent/.flow-icons-stage.XXXXXX")"
stage_dir="$stage_root/next"
backup_dir="$stage_root/previous"
swap_complete=false

cleanup() {
  local status=$1 retain_stage=false
  trap - EXIT INT TERM

  # If interruption lands between the two renames, put the last complete
  # extension back. Never delete the only remaining backup.
  if [[ -e "$backup_dir" && ! -e "$EXTENSION_DIR" ]]; then
    if mv -- "$backup_dir" "$EXTENSION_DIR"; then
      warn "restored the previously working extension"
    else
      retain_stage=true
      warn "automatic restore failed; backup retained at $backup_dir"
    fi
  elif [[ -e "$backup_dir" && "$swap_complete" != true ]]; then
    retain_stage=true
    warn "interrupted update backup retained at $backup_dir"
  fi

  case "$stage_root" in
    "$extension_parent"/.flow-icons-stage.*)
      if [[ "$retain_stage" != true && -e "$stage_root" ]]; then
        rm -rf -- "$stage_root"
      fi
      ;;
  esac
  exit "$status"
}
trap 'cleanup "$?"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

mkdir -p "$stage_dir"
cp -R "$SOURCE_DIR/." "$stage_dir/"
if [[ -n "$(find "$stage_dir" -type l -print -quit)" ]]; then
  fail "reviewed Flow Icons source unexpectedly contains a symbolic link"
  exit 1
fi

installed_revision=""
if [[ -r "$EXTENSION_DIR/.flow-icons-source-revision" ]]; then
  installed_revision="$(<"$EXTENSION_DIR/.flow-icons-source-revision")"
fi

# Reuse downloaded icon payloads only when the reviewed updater revision is
# unchanged. The updater still checks their remote version before installing.
if [[ "$installed_revision" == "$SOURCE_REVISION" ]]; then
  if [[ -d "$EXTENSION_DIR/icons" ]]; then
    cp -R "$EXTENSION_DIR/icons" "$stage_dir/"
  fi
  if [[ -r "$EXTENSION_DIR/.icon-version" ]]; then
    cp "$EXTENSION_DIR/.icon-version" "$stage_dir/.icon-version"
  fi
fi
if [[ -r "$EXTENSION_DIR/config.json" ]]; then
  cp "$EXTENSION_DIR/config.json" "$stage_dir/config.json"
fi

license_available=false
premium=false
if [[ "$public_only" == false && -x "$DOTS_BIN" ]] &&
  "$DOTS_BIN" secret status flow-icons >/dev/null 2>&1; then
  license_available=true
  if [[ -r "$CONSENT_FILE" ]]; then
    premium=true
  elif [[ -t 0 && -r /dev/tty ]]; then
    printf '%s\n' \
      "Flow Icons premium sends the licence as an Authorization header to" \
      "https://legit-i9lq.onrender.com/flow-icons and sends an MD5-derived" \
      "hostname identifier."
    printf 'Allow this disclosure and remember the choice? [y/N] ' >/dev/tty
    read -r consent </dev/tty
    case "$consent" in
      y | Y | yes | YES)
        umask 077
        mkdir -p "$(dirname "$CONSENT_FILE")"
        printf '%s\n' "Approved Flow Icons premium API disclosure v1" >"$CONSENT_FILE"
        premium=true
        ;;
      *)
        note "Premium update declined; installing public icons."
        ;;
    esac
  else
    note "Premium licence found, but consent has not been recorded."
    note "Run 'braden-dots app flow-icons' interactively; installing public icons now."
  fi
elif [[ "$public_only" == false ]]; then
  note "Flow Icons licence is not available."
{{ if eq .machineType "work" }}
  note "Add 'Flow Icons License' with a 'license key' field to the work vault,"
  note "or provision it from a trusted personal Mac with:"
  note "braden-dots secret set flow-icons --vault '<work-vault-id>'"
{{ else }}
  note "Add 'Flow Icons License' with a 'license key' field to the configured vault,"
  note "or store it with: braden-dots secret set flow-icons"
{{ end }}
fi

if [[ "$license_available" == true ]]; then
  project_editor_license \
    "VS Code" \
    "$VSCODE_SETTINGS" \
    "/Applications/Visual Studio Code.app" \
    code
  project_editor_license \
    "Cursor" \
    "$CURSOR_SETTINGS" \
    "/Applications/Cursor.app" \
    cursor
fi

printf 'Building Flow Icons in a staging directory...\n'
readonly node_guard='
  const fs = require("node:fs");
  const path = require("node:path");
  const root = fs.realpathSync(process.cwd());
  delete process.env.FLOW_ICONS_LICENSE;
  const withinRoot = (target) => {
    const resolved = path.resolve(String(target));
    if (resolved !== root && !resolved.startsWith(root + path.sep)) {
      throw new Error("refusing write outside staging directory: " + resolved);
    }
  };
  for (const method of ["mkdirSync", "rmSync", "writeFileSync"]) {
    const original = fs[method].bind(fs);
    fs[method] = (target, ...args) => {
      withinRoot(target);
      return original(target, ...args);
    };
  }
  const key = process.env.DOTFILES_FLOW_PREMIUM === "1"
    ? fs.readFileSync(0, "utf8").trim()
    : "";
  if (process.env.DOTFILES_FLOW_PREMIUM === "1" && !key) {
    throw new Error("Flow Icons licence lookup returned no value");
  }
  if (key) process.argv[2] = key;
  require(path.join(root, "update-icons.cjs"));
'
if [[ "$premium" == true ]]; then
  (
    cd "$stage_dir"
    "$DOTS_BIN" secret read flow-icons |
      FLOW_ICONS_LICENSE='' DOTFILES_FLOW_PREMIUM=1 \
        "$node_bin" -e "$node_guard"
  )
else
  (
    cd "$stage_dir"
    FLOW_ICONS_LICENSE='' DOTFILES_FLOW_PREMIUM=0 \
      "$node_bin" -e "$node_guard"
  )
fi

# Record the source only after the updater has completed successfully.
printf '%s\n' "$SOURCE_REVISION" >"$stage_dir/.flow-icons-source-revision"

if [[ -e "$EXTENSION_DIR" ]]; then
  mv -- "$EXTENSION_DIR" "$backup_dir"
fi
if ! mv -- "$stage_dir" "$EXTENSION_DIR"; then
  fail "could not install the staged extension"
  exit 1
fi
swap_complete=true

printf '[ok] Flow Icons is ready in %s\n' "$EXTENSION_DIR"
note "Restart Zed if it was open during the update."

{{- /* Authentication follows the same machine trust boundary as braden-dots identity. */ -}}
{{- /* braden-dots secret module. */ -}}
{{- $backend := ternary "service-account" "desktop" (eq (or (get . "machineType") "personal") "work") -}}
{{- $vault := or (get . "opVault") "" -}}
#!/bin/bash
set -uo pipefail

# Read application secrets from 1Password without templating their values into
# chezmoi state. The registry below contains coordinates and policy only.

readonly BACKEND={{ $backend | quote }}
readonly MACHINE_TYPE={{ (or (get . "machineType") "personal") | quote }}
readonly VAULT={{ $vault | quote }}
readonly KEYCHAIN_ACCOUNT={{ .chezmoi.username | quote }}
readonly KEYCHAIN_SERVICE={{ get . "opTokenKeychainService" | default "dotfiles-op-service-account" | quote }}
readonly TOKEN_FILE={{ joinPath .chezmoi.homeDir .credentials.serviceAccountTokenFile | quote }}

usage() {
  cat <<'USAGE'
Usage: braden-dots secret <command>

Commands:
  list
  status [alias]
  read <alias>
  set <alias> [--vault <vault>]
              [--from-keychain <service>] [--account <account>]

`read` writes only the secret to stdout. `set` prompts securely or migrates an
existing Keychain item; values reach 1Password through stdin and never appear
in command arguments or managed files.
USAGE
}

pass() { printf '[ok] %s\n' "$*"; }
warn() { printf '[!!] %s\n' "$*"; }
fail() { printf '[xx] %s\n' "$*" >&2; }
note() { printf '[--] %s\n' "$*"; }

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    fail "$1 is required but not installed"
    return 1
  fi
}

SECRET_ALIAS=""
SECRET_ITEM=""
SECRET_FIELD=""
SECRET_FIELD_ID=""
SECRET_PROFILES=""
SECRET_OPTIONAL=false
SECRET_DESCRIPTION=""

lookup_secret() {
  SECRET_ALIAS=""
  SECRET_ITEM=""
  SECRET_FIELD=""
  SECRET_FIELD_ID=""
  SECRET_PROFILES=""
  SECRET_OPTIONAL=false
  SECRET_DESCRIPTION=""

  case "$1" in
{{- range $alias, $secret := .runtimeSecrets }}
    {{ $alias | quote }})
      SECRET_ALIAS={{ $alias | quote }}
      SECRET_ITEM={{ $secret.item | quote }}
      SECRET_FIELD={{ $secret.field | quote }}
      SECRET_FIELD_ID={{ or (get $secret "fieldId") $secret.field | quote }}
      SECRET_PROFILES={{ join "," $secret.profiles | quote }}
      SECRET_OPTIONAL={{ $secret.optional }}
      SECRET_DESCRIPTION={{ $secret.description | quote }}
      ;;
{{- end }}
    *)
      fail "unknown secret alias: $1"
      note "Run: braden-dots secret list"
      return 2
      ;;
  esac
}

secret_is_allowed() {
  case ",$SECRET_PROFILES," in
    *",$MACHINE_TYPE,"*) return 0 ;;
    *)
      fail "$SECRET_ALIAS is disabled for the $MACHINE_TYPE profile"
      return 1
      ;;
  esac
}

file_mode() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%OLp' "$1" 2>/dev/null
}

file_owner_uid() {
  stat -c '%u' "$1" 2>/dev/null || stat -f '%u' "$1" 2>/dev/null
}

token_file_is_safe() {
  [[ -f "$TOKEN_FILE" && ! -L "$TOKEN_FILE" && -r "$TOKEN_FILE" ]] || return 1
  if [[ "$(file_mode "$TOKEN_FILE")" != 600 ]]; then
    fail "refusing service-account token file without mode 0600: $TOKEN_FILE"
    return 1
  fi
  if [[ "$(file_owner_uid "$TOKEN_FILE")" != "$(id -u)" ]]; then
    fail "refusing service-account token file not owned by the current user"
    return 1
  fi
}

service_account_token() {
  if [[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]]; then
    printf '%s' "$OP_SERVICE_ACCOUNT_TOKEN"
    return 0
  fi
  if command -v security >/dev/null 2>&1; then
    local from_keychain
    if from_keychain="$(
      security find-generic-password \
        -w -a "$KEYCHAIN_ACCOUNT" -s "$KEYCHAIN_SERVICE" 2>/dev/null
    )"; then
      printf '%s' "$from_keychain"
      return 0
    fi
  fi
  if token_file_is_safe; then
    tr -d '[:space:]' <"$TOKEN_FILE"
    return 0
  fi
  return 1
}

op_run() {
  if [[ "$BACKEND" == service-account ]]; then
    local token
    if ! token="$(service_account_token)"; then
      fail "no safe 1Password service-account token was found"
      fail "Store one with: braden-dots identity store-token"
      return 1
    fi
    token="${token//[$'\n\r\t ']/}"
    if [[ -z "$token" ]]; then
      fail "the stored service-account token is empty"
      return 1
    fi
    (
      unset OP_CONNECT_HOST OP_CONNECT_TOKEN
      OP_SERVICE_ACCOUNT_TOKEN="$token" op "$@"
    )
  else
    (
      unset OP_SERVICE_ACCOUNT_TOKEN OP_CONNECT_HOST OP_CONNECT_TOKEN
      op "$@"
    )
  fi
}

require_vault() {
  if [[ -z "$1" ]]; then
    fail "no 1Password vault is configured; run: braden-dots config edit"
    return 1
  fi
}

resolve_vault_id() {
  local vault=$1 id
  id="$(op_run vault get "$vault" --format json 2>/dev/null |
    jq -r '.id // empty')" || return 1
  if [[ -z "$id" ]]; then
    fail "could not resolve the vault: $vault"
    return 1
  fi
  printf '%s' "$id"
}

item_json() {
  local vault_id=$1
  op_run item get "$SECRET_ITEM" --vault "$vault_id" --format json 2>/dev/null
}

item_id() {
  local vault_id=$1 json id
  if ! json="$(item_json "$vault_id")"; then
    return 1
  fi
  id="$(jq -r '.id // empty' <<<"$json")"
  [[ -n "$id" ]] || return 1
  printf '%s' "$id"
}

secret_reference() {
  local vault_id=$1 resolved_item_id=$2 resolved_field_id=$3
  printf 'op://%s/%s/%s' "$vault_id" "$resolved_item_id" "$resolved_field_id"
}

read_secret() {
  local alias=$1 vault_id json resolved_item_id resolved_field_id value
  lookup_secret "$alias" || return
  secret_is_allowed || return
  require_command op || return
  require_command jq || return
  require_vault "$VAULT" || return
  vault_id="$(resolve_vault_id "$VAULT")" || {
    fail "could not resolve the configured vault"
    return 1
  }
  if ! json="$(item_json "$vault_id")"; then
    fail "could not find $SECRET_ITEM in $VAULT"
    return 1
  fi
  resolved_item_id="$(jq -r '.id // empty' <<<"$json")"
  resolved_field_id="$(
    jq -r \
      --arg field "$SECRET_FIELD" \
      --arg field_id "$SECRET_FIELD_ID" \
      'first(
         .fields[]? |
         select(.id == $field_id or .label == $field) |
         .id
       ) // empty' <<<"$json"
  )"
  if [[ -z "$resolved_item_id" || -z "$resolved_field_id" ]]; then
    fail "could not find $SECRET_FIELD in $SECRET_ITEM"
    return 1
  fi
  if ! value="$(
    op_run read --no-newline \
      "$(secret_reference "$vault_id" "$resolved_item_id" "$resolved_field_id")"
  )"; then
    fail "could not read $SECRET_FIELD from $SECRET_ITEM"
    return 1
  fi
  if [[ -z "$value" ]]; then
    fail "$SECRET_FIELD is empty in $SECRET_ITEM"
    return 1
  fi
  printf '%s' "$value"
  unset value
}

status_one() {
  local alias=$1 quiet=${2:-false} vault_id json
  lookup_secret "$alias" || return
  if ! secret_is_allowed >/dev/null 2>&1; then
    [[ "$quiet" == true ]] || note "$SECRET_ALIAS: disabled on $MACHINE_TYPE"
    return 1
  fi
  require_command op || return
  require_command jq || return
  require_vault "$VAULT" || return
  vault_id="$(resolve_vault_id "$VAULT")" || {
    [[ "$quiet" == true ]] || warn "$SECRET_ALIAS: vault is unavailable"
    return 1
  }
  if ! json="$(item_json "$vault_id")"; then
    [[ "$quiet" == true ]] || note "$SECRET_ALIAS: not stored"
    return 1
  fi
  if ! jq -e \
    --arg field "$SECRET_FIELD" \
    --arg field_id "$SECRET_FIELD_ID" \
    'any(.fields[]?; .id == $field_id or .label == $field)' \
    >/dev/null <<<"$json"; then
    [[ "$quiet" == true ]] || warn "$SECRET_ALIAS: item exists but field is missing"
    return 1
  fi
  [[ "$quiet" == true ]] || pass "$SECRET_ALIAS: available in $VAULT"
}

emit_item_template() {
  local value=$1
  printf '%s' "$value" |
    jq -Rs \
      --arg title "$SECRET_ITEM" \
      --arg field "$SECRET_FIELD" \
      --arg field_id "$SECRET_FIELD_ID" \
      --arg description "$SECRET_DESCRIPTION" \
      '{
        title: $title,
        category: "API_CREDENTIAL",
        tags: ["dotfiles-secret"],
        fields: [
          {
            id: "username",
            label: "username",
            type: "STRING",
            purpose: "USERNAME",
            value: $description
          },
          {
            id: $field_id,
            label: $field,
            type: "CONCEALED",
            purpose: "PASSWORD",
            value: .
          },
          {
            id: "type",
            label: "type",
            type: "MENU",
            value: "other"
          }
        ]
      }'
}

emit_updated_item() {
  local vault_id=$1 resolved_item_id=$2 value=$3
  op_run item get "$resolved_item_id" \
    --vault "$vault_id" \
    --format json \
    --reveal |
    jq \
      --rawfile replacement /dev/fd/3 \
      --arg field "$SECRET_FIELD" \
      --arg field_id "$SECRET_FIELD_ID" \
      '
        ($replacement) as $value |
        if any(.fields[]?; .id == $field_id or .label == $field) then
          .fields |= map(
            if .id == $field_id or .label == $field then
              .label = $field |
              .type = "CONCEALED" |
              .purpose = "PASSWORD" |
              .value = $value
            else
              .
            end
          )
        else
          .fields += [{
            id: $field_id,
            label: $field,
            type: "CONCEALED",
            purpose: "PASSWORD",
            value: $value
          }]
        end
      ' 3< <(printf '%s' "$value")
}

store_secret_value() {
  local target_vault=$1 value=$2 vault_id probe probe_status=0
  local resolved_item_id=""
  require_command op || return
  require_command jq || return
  require_vault "$target_vault" || return
  vault_id="$(resolve_vault_id "$target_vault")" || {
    fail "could not resolve the target vault: $target_vault"
    return 1
  }

  probe="$(op_run item get "$SECRET_ITEM" \
    --vault "$vault_id" --format json 2>&1)" || probe_status=$?
  if [[ "$probe_status" -eq 0 ]]; then
    if [[ "$(jq -r '.category // empty' <<<"$probe")" != API_CREDENTIAL ]]; then
      fail "refusing to edit a non-API credential named $SECRET_ITEM"
      return 1
    fi
    resolved_item_id="$(jq -r '.id // empty' <<<"$probe")"
    if [[ -z "$resolved_item_id" ]]; then
      fail "the existing item has no ID: $SECRET_ITEM"
      return 1
    fi
    # Merge into the revealed item JSON instead of rebuilding it, preserving
    # notes, tags, URLs and any unrelated fields. The replacement reaches jq on
    # an anonymous file descriptor, not through argv, an environment variable
    # or a temporary file.
    if emit_updated_item "$vault_id" "$resolved_item_id" "$value" |
      op_run item edit "$resolved_item_id" --vault "$vault_id" >/dev/null; then
      pass "updated $SECRET_ALIAS in $target_vault"
    else
      fail "could not update $SECRET_ITEM"
      return 1
    fi
  elif grep -qiE "isn't an item|not found|no item matches" <<<"$probe"; then
    if emit_item_template "$value" |
      op_run item create --vault "$vault_id" - >/dev/null; then
      pass "created $SECRET_ALIAS in $target_vault"
    else
      fail "could not create $SECRET_ITEM"
      return 1
    fi
  else
    fail "could not determine whether $SECRET_ITEM already exists"
    printf '%s\n' "$probe" | sed 's/^/     /' >&2
    return 1
  fi
}

parse_write_options() {
  TARGET_VAULT=$VAULT
  SOURCE_KEYCHAIN_SERVICE=""
  SOURCE_KEYCHAIN_ACCOUNT=$KEYCHAIN_ACCOUNT
  while (($# > 0)); do
    case "$1" in
      --vault)
        [[ $# -ge 2 && -n "$2" ]] || {
          fail "--vault needs a value"
          return 2
        }
        TARGET_VAULT=$2
        shift 2
        ;;
      --from-keychain)
        [[ $# -ge 2 && -n "$2" ]] || {
          fail "--from-keychain needs a service name"
          return 2
        }
        SOURCE_KEYCHAIN_SERVICE=$2
        shift 2
        ;;
      --account)
        [[ $# -ge 2 && -n "$2" ]] || {
          fail "--account needs a value"
          return 2
        }
        SOURCE_KEYCHAIN_ACCOUNT=$2
        shift 2
        ;;
      *)
        fail "unknown option: $1"
        return 2
        ;;
    esac
  done
}

cmd_list() {
  local alias
{{- range $alias, $_ := .runtimeSecrets }}
  alias={{ $alias | quote }}
  lookup_secret "$alias"
  printf '%-20s %-14s %s%s\n' \
    "$SECRET_ALIAS" "$SECRET_PROFILES" "$SECRET_DESCRIPTION" \
    "$(if [[ "$SECRET_OPTIONAL" == true ]]; then printf ' (optional)'; fi)"
{{- end }}
}

cmd_status() {
  if [[ $# -gt 1 ]]; then
    fail "usage: braden-dots secret status [alias]"
    return 2
  fi
  if [[ $# -eq 1 ]]; then
    status_one "$1"
    return
  fi

  local alias required_failure=0
{{- range $alias, $_ := .runtimeSecrets }}
  alias={{ $alias | quote }}
  if ! status_one "$alias"; then
    lookup_secret "$alias"
    [[ "$SECRET_OPTIONAL" == true ]] || required_failure=1
  fi
{{- end }}
  return "$required_failure"
}

cmd_set() {
  local alias=${1:-}
  [[ -n "$alias" ]] || {
    fail "usage: braden-dots secret set <alias> [--vault <vault>]"
    return 2
  }
  shift
  lookup_secret "$alias" || return
  secret_is_allowed || return
  if [[ "$BACKEND" != desktop ]]; then
    fail "service-account machines cannot write application secrets"
    note "Provision the work-readable vault from a trusted personal machine."
    return 1
  fi
  parse_write_options "$@" || return

  local value
  if [[ -n "$SOURCE_KEYCHAIN_SERVICE" ]]; then
    require_command security || return
    if ! value="$(
      security find-generic-password \
        -w \
        -a "$SOURCE_KEYCHAIN_ACCOUNT" \
        -s "$SOURCE_KEYCHAIN_SERVICE"
    )"; then
      fail "could not read '$SOURCE_KEYCHAIN_SERVICE' from the login keychain"
      return 1
    fi
  else
    if [[ ! -r /dev/tty ]]; then
      fail "a terminal is required for hidden secret entry"
      return 1
    fi
    printf 'Enter %s: ' "$SECRET_DESCRIPTION" >/dev/tty
    IFS= read -r -s value </dev/tty
    printf '\n' >/dev/tty
  fi
  if [[ -z "$value" ]]; then
    fail "the secret was empty; nothing changed"
    return 1
  fi
  store_secret_value "$TARGET_VAULT" "$value"
  local result=$?
  unset value
  if [[ "$result" -eq 0 && -n "$SOURCE_KEYCHAIN_SERVICE" ]]; then
    note "The Keychain copy was left in place. Verify Flow Icons, then remove"
    note "that old item explicitly if you no longer need the rollback."
  fi
  return "$result"
}

main() {
  local command=${1:-status}
  case "$command" in
    list) shift; [[ $# -eq 0 ]] || { usage >&2; return 2; }; cmd_list ;;
    status) shift; cmd_status "$@" ;;
    read) shift; [[ $# -eq 1 ]] || { usage >&2; return 2; }; read_secret "$1" ;;
    set) shift; cmd_set "$@" ;;
    -h | --help | help) usage ;;
    *)
      fail "unknown command: $command"
      usage >&2
      return 2
      ;;
  esac
}

main "$@"

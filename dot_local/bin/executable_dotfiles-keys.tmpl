{{- /* Derived from machineType, never from a persisted key that a stale
       machine-local config would be missing. See .chezmoi.toml.tmpl. */ -}}
{{- $backend := ternary "service-account" "desktop" (eq (or (get . "machineType") "personal") "work") -}}
{{- $vault := or (get . "opVault") "" -}}
{{- /* Prompted, not inferred: see the machineName comment in .chezmoi.toml.tmpl. */ -}}
{{- $machine := or (get . "machineName") "unnamed" -}}
#!/bin/bash
set -uo pipefail

# Manage the GitHub credentials this machine uses, without ever writing a
# private key to disk.
#
#   desktop         The 1Password app authenticates the CLI. Keys are streamed
#                   into the OS ssh-agent until logout.
#   service-account The app is not installed. Keys are read from the shared
#                   vault on demand and added to the OS ssh-agent with a
#                   lifetime, so a revoked service account takes effect at the
#                   next load instead of leaving a usable key behind.
#
# Keys are per-machine. One shared pair would make revocation all-or-nothing
# and leave signatures unattributable: you could not tell which machine signed
# a commit, nor distrust one machine without rotating every machine. Scoping
# the vault items by hostname means retiring one machine only requires deleting
# that machine's default and account-specific GitHub keys.

readonly BACKEND={{ $backend | quote }}
readonly VAULT={{ $vault | quote }}
# Baked at render time so the item name cannot drift if the running hostname
# changes underneath a machine that already published its keys.
readonly MACHINE={{ $machine | quote }}
readonly AUTH_ITEM={{ printf "%s (%s)" .credentials.authItemPrefix $machine | quote }}
readonly SIGN_ITEM={{ printf "%s (%s)" .credentials.signItemPrefix $machine | quote }}
readonly AUTH_ITEM_PREFIX={{ .credentials.authItemPrefix | quote }}
readonly SIGN_ITEM_PREFIX={{ .credentials.signItemPrefix | quote }}
readonly IDENTITY_PREFIX={{ .credentials.identityItemPrefix | quote }}
readonly IDENTITY_EMAIL_FIELD={{ .credentials.identityEmailField | quote }}
readonly IDENTITY_SCOPE_FIELD={{ .credentials.identityScopeField | quote }}
readonly IDENTITY_INCLUDE={{ joinPath .chezmoi.homeDir .credentials.identityIncludeFile | quote }}
readonly IDENTITY_DIR={{ joinPath .chezmoi.homeDir .credentials.identityDir | quote }}
readonly SSH_INCLUDE_DIR={{ joinPath .chezmoi.homeDir .credentials.sshIncludeDir | quote }}
readonly GIT_NAME={{ .gitName | quote }}
readonly DEFAULT_EMAIL={{ .defaultEmail | quote }}
readonly TOKEN_ITEM={{ .credentials.tokenItem | quote }}
readonly PUBLIC_FIELD={{ .credentials.publicKeyField | quote }}
readonly TOKEN_FIELD={{ .credentials.tokenField | quote }}
readonly KEY_LIFETIME={{ .credentials.agentKeyLifetime | quote }}
readonly KEYCHAIN_SERVICE={{ get . "opTokenKeychainService" | default "dotfiles-op-service-account" | quote }}
readonly TOKEN_FILE={{ joinPath .chezmoi.homeDir .credentials.serviceAccountTokenFile | quote }}
readonly SSH_DIR={{ joinPath .chezmoi.homeDir ".ssh" | quote }}
readonly ALLOWED_SIGNERS={{ joinPath .chezmoi.homeDir ".ssh/allowed_signers" | quote }}
readonly AUTH_KEY_FILE={{ joinPath .chezmoi.homeDir ".ssh/id_github_auth.pub" | quote }}
readonly SIGN_KEY_FILE={{ joinPath .chezmoi.homeDir ".ssh/id_github_sign.pub" | quote }}

# Public halves live on disk, written from the vault by `sync`. Chezmoi does not
# template them: key material has one source of truth, and reading the vault at
# render time would make every `chezmoi status` prompt for biometrics.
recorded_key() {
  [[ -r "$1" ]] && cat "$1"
}

# 1Password stores SSH keys in its own representation; this query asks for the
# OpenSSH encoding that ssh-add understands.
readonly PRIVATE_REFERENCE_SUFFIX='private key?ssh-format=openssh'

usage() {
  cat <<'USAGE'
Usage: dotfiles-keys <command>

Commands:
  setup         Guided first run for this machine's credential backend
  provision     Create+publish keys for another machine/account
                provision <machine> [--identity <slug>] [--vault <vault>]
                                      [--github-user <login>]
  store-token   Store the service account token in the macOS keychain (work only)
  status        Report the credential backend, agent, and which keys are usable
  generate      Create this machine's SSH keys inside 1Password
  publish       Add this machine's public keys to your GitHub account
  sync          Write public keys, git identities and the trust store from the vault
  sync-signers  Rebuild only ~/.ssh/allowed_signers from every machine in the vault
  identity-add  Add a git identity
                identity-add <slug> <email> <owner/** | owner/repo>
                             [--vault <vault>]
  load          Read this machine's keys from 1Password into the ssh-agent
  unload        Drop the loaded keys from the ssh-agent
  token         Print the GitHub token from the vault, for GH_TOKEN

Keys are per-machine, named for this host, so retiring one machine does not
rotate any other machine's credentials. Private keys are never written to
disk: `generate` creates them inside 1Password and `load` streams them straight
into the agent.
USAGE
}

pass() { printf '[ok] %s\n' "$*"; }
warn() { printf '[!!] %s\n' "$*"; }
fail() { printf '[xx] %s\n' "$*" >&2; }
note() { printf '[--] %s\n' "$*"; }

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    fail "$1 is required but not installed"
    return 1
  fi
}

# GNU first: BSD stat rejects -c outright and prints nothing, whereas GNU stat
# reads -f as --file-system and prints a filesystem report to stdout while
# exiting non-zero, which would poison a BSD-first probe with junk.
file_mode() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%OLp' "$1" 2>/dev/null
}

require_vault() {
  if [[ -z "$VAULT" ]]; then
    fail "no 1Password vault is configured; run: chezmoi init --prompt"
    return 1
  fi
}

# Resolve the service account token, preferring the strongest store available.
# A 0600 file is readable by anything running as this user; a Keychain item is
# encrypted at rest and gated by the item's own access control. The file is
# kept as a fallback so non-macOS hosts still work.
service_account_token() {
  if [[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]]; then
    printf '%s' "$OP_SERVICE_ACCOUNT_TOKEN"
    return 0
  fi
  if command -v security >/dev/null 2>&1; then
    local from_keychain
    if from_keychain="$(security find-generic-password -w -s "$KEYCHAIN_SERVICE" 2>/dev/null)"; then
      printf '%s' "$from_keychain"
      return 0
    fi
  fi
  if [[ -r "$TOKEN_FILE" ]]; then
    tr -d '[:space:]' <"$TOKEN_FILE"
    return 0
  fi
  return 1
}

# Which store answered, for status and doctor output. Never prints the token.
token_source() {
  if [[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]]; then
    printf 'environment'
  elif command -v security >/dev/null 2>&1 &&
    security find-generic-password -s "$KEYCHAIN_SERVICE" >/dev/null 2>&1; then
    printf 'keychain'
  elif [[ -r "$TOKEN_FILE" ]]; then
    printf 'file'
  else
    printf 'none'
  fi
}

# Supply the service account token to a single op invocation rather than
# exporting it into the environment of every process in the session.
op_run() {
  if [[ "$BACKEND" == "service-account" ]]; then
    local token
    # Diagnostics stay on stderr: `dotfiles-keys token` is captured as $(...)
    # by callers, and advice printed on stdout becomes the token.
    if ! token="$(service_account_token)"; then
      fail "no 1Password service account token found"
      fail "Store one with: dotfiles-keys store-token"
      return 1
    fi
    token="${token//[$'\n\r\t ']/}"
    if [[ -z "$token" ]]; then
      fail "the stored service account token is empty"
      return 1
    fi
    OP_SERVICE_ACCOUNT_TOKEN="$token" op "$@"
  else
    op "$@"
  fi
}

# Secret references reject characters that are perfectly legal in a vault or
# item name -- '<' among them, which a name like "Braden<>Work" contains. IDs
# are alphanumeric, so resolve names to IDs once and build references from
# those. This makes the script indifferent to whatever the vault is called.
VAULT_ID=""
resolve_vault_id() {
  if [[ -n "$VAULT_ID" ]]; then
    printf '%s' "$VAULT_ID"
    return 0
  fi
  local id
  id="$(op_run vault get "$VAULT" --format json 2>/dev/null | jq -r '.id // empty')"
  if [[ -z "$id" ]]; then
    fail "could not resolve the vault: $VAULT"
    return 1
  fi
  VAULT_ID="$id"
  printf '%s' "$VAULT_ID"
}

resolve_item_id() {
  local vault_id
  vault_id="$(resolve_vault_id)" || return 1
  local item
  item="$(op_run item get "$1" --vault "$vault_id" --format json 2>/dev/null)" ||
    return 1
  jq -r '.id // empty' <<<"$item"
}

# The default GitHub account uses the base machine title. An identity that owns
# credentials on a separate account adds its slug. Keeping both forms here
# means `provision` on one machine and `sync` on another cannot drift.
machine_item_title() {
  local kind="$1" machine="$2"
  case "$kind" in
    auth) printf '%s (%s)' "$AUTH_ITEM_PREFIX" "$machine" ;;
    sign) printf '%s (%s)' "$SIGN_ITEM_PREFIX" "$machine" ;;
  esac
}

account_item_title() {
  local kind="$1" machine="$2" slug="$3"
  case "$kind" in
    auth) printf '%s (%s %s)' "$AUTH_ITEM_PREFIX" "$machine" "$slug" ;;
    sign) printf '%s (%s %s)' "$SIGN_ITEM_PREFIX" "$machine" "$slug" ;;
  esac
}

reference() {
  local vault_id
  vault_id="$(resolve_vault_id)" || return 1
  printf 'op://%s/%s/%s' "$vault_id" "$1" "$2"
}

# Read a field by label rather than through a secret reference: no reference
# parsing, so no character restrictions on the item title either.
read_public_key() {
  local vault_id
  vault_id="$(resolve_vault_id)" || return 1
  op_run item get "$1" --vault "$vault_id" --fields label="$PUBLIC_FIELD" 2>/dev/null
}

read_public_key_from() {
  local item="$1" vault="$2"
  op_run item get "$item" --vault "$vault" --fields label="$PUBLIC_FIELD" --reveal 2>/dev/null
}

vault_items_json() {
  local vault_id
  vault_id="$(resolve_vault_id)" || return 1
  op_run item list --vault "$vault_id" --format json 2>/dev/null
}

item_id_from_json() {
  local items="$1" title="$2"
  local matches count
  matches="$(jq -r --arg title "$title" \
    '.[] | select(.title == $title) | .id' <<<"$items")" || return 1
  count="$(awk 'NF { count++ } END { print count + 0 }' <<<"$matches")"
  if [[ "$count" -gt 1 ]]; then
    fail "duplicate 1Password items named '$title'; refusing an arbitrary key"
    return 1
  fi
  printf '%s' "$matches"
}

item_title_exists_in_json() {
  local items="$1" title="$2"
  jq -e --arg title "$title" \
    'any(.[]; .title == $title)' <<<"$items" >/dev/null
}

# Compare against the agent by key body only: comments differ between what
# 1Password stores and what ssh-add reports. A key missing its base64 body
# would otherwise reduce to a bare algorithm name and match every key of that
# type, so require both fields.
key_body() {
  awk 'NF >= 2 { print $1 " " $2 }' <<<"$1"
}

agent_holds_key() {
  local public_key="$1" body loaded
  [[ -n "$public_key" ]] || return 1
  body="$(key_body "$public_key")"
  [[ -n "$body" ]] || return 1
  loaded="$(ssh-add -L 2>/dev/null)" || return 1
  grep -Fq -- "$body" <<<"$loaded"
}

agent_available() {
  # A missing ssh-add is not a reachable agent. Check the binary first, then
  # distinguish "cannot contact the agent" (2) from "agent holds nothing" (1).
  command -v ssh-add >/dev/null 2>&1 || return 1
  local status=0
  ssh-add -l >/dev/null 2>&1 || status=$?
  [[ "$status" -ne 2 ]]
}

cmd_status() {
  local exit_code=0
  require_safe_machine || exit_code=1

  printf 'Credential backend\n'
  note "backend: $BACKEND"
  note "machine: $MACHINE"
  note "vault:   ${VAULT:-<unset>}"
  if [[ -r "$ALLOWED_SIGNERS" ]]; then
    note "trusted signing keys: $(awk '{ print $2 " " $3 }' "$ALLOWED_SIGNERS" | sort -u | wc -l | tr -d ' ')"
  else
    warn "no trust store yet; run: dotfiles-keys sync"
  fi

  printf '\nTooling\n'
  if require_command op; then
    pass "op is available"
  else
    exit_code=1
  fi
  if require_command ssh-add; then
    pass "ssh-add is available"
  else
    exit_code=1
  fi
  if command -v gh >/dev/null 2>&1; then
    pass "gh is available"
  else
    warn "gh is not installed; publishing public keys will not work"
  fi

  printf '\nAgent\n'
  if agent_available; then
    pass "an ssh-agent is reachable at ${SSH_AUTH_SOCK:-<unset>}"
  else
    fail "no ssh-agent is reachable"
    exit_code=1
  fi

  if [[ "$BACKEND" == "service-account" ]]; then
    # A durable on-disk key defeats the entire arrangement: revoking the
    # service account cannot reach it, so the machine keeps its GitHub access
    # forever. Treat it as an error, not a compatibility affordance.
    local stray
    for stray in "$HOME/.ssh/id_ed25519" "$HOME/.ssh/id_rsa" "$HOME/.ssh/id_ecdsa"; do
      if [[ -f "$stray" ]]; then
        fail "a private key is on disk and would survive revocation: $stray"
        note "Remove it and delete the matching key from GitHub, or this machine"
        note "keeps access after the service account is revoked."
        exit_code=1
      fi
    done

    case "$(token_source)" in
      keychain) pass "service account token is in the login keychain" ;;
      environment) warn "service account token is coming from the environment" ;;
      file)
        local mode
        mode="$(file_mode "$TOKEN_FILE")"
        warn "service account token is a plaintext file (mode ${mode:-unknown})"
        note "Prefer the keychain: dotfiles-keys store-token"
        ;;
      *)
        fail "no service account token found; run: dotfiles-keys store-token"
        exit_code=1
        ;;
    esac
  fi

  printf '\nLocal public keys\n'
  local auth_key sign_key
  auth_key="$(recorded_key "$AUTH_KEY_FILE")"
  sign_key="$(recorded_key "$SIGN_KEY_FILE")"
  if [[ -n "$auth_key" ]]; then
    pass "authentication public key is present"
  else
    warn "no authentication public key; run: dotfiles-keys sync"
  fi
  if [[ -n "$sign_key" ]]; then
    pass "signing public key is present"
  else
    warn "no signing public key; run: dotfiles-keys sync"
  fi

  printf '\nKeys usable right now\n'
  if agent_holds_key "$auth_key"; then
    pass "the agent holds the authentication key"
  else
    warn "the agent does not hold the authentication key; run: dotfiles-keys load"
  fi
  if agent_holds_key "$sign_key"; then
    pass "the agent holds the signing key"
  else
    warn "the agent does not hold the signing key; run: dotfiles-keys load"
  fi

  local account_auth_file account_sign_file account_slug account_auth_key account_sign_key
  for account_auth_file in "$SSH_DIR"/id_github_auth_*.pub; do
    [[ -e "$account_auth_file" ]] || continue
    account_slug="${account_auth_file##*/id_github_auth_}"
    account_slug="${account_slug%.pub}"
    account_sign_file="$SSH_DIR/id_github_sign_$account_slug.pub"
    if [[ ! -r "$account_sign_file" ]]; then
      fail "identity '$account_slug' has an auth public key but no signing public key"
      exit_code=1
      continue
    fi
    account_auth_key="$(recorded_key "$account_auth_file")"
    account_sign_key="$(recorded_key "$account_sign_file")"
    if agent_holds_key "$account_auth_key"; then
      pass "the agent holds the '$account_slug' authentication key"
    else
      warn "the agent does not hold the '$account_slug' authentication key; run: dotfiles-keys load"
    fi
    if agent_holds_key "$account_sign_key"; then
      pass "the agent holds the '$account_slug' signing key"
    else
      warn "the agent does not hold the '$account_slug' signing key; run: dotfiles-keys load"
    fi
  done
  for account_sign_file in "$SSH_DIR"/id_github_sign_*.pub; do
    [[ -e "$account_sign_file" ]] || continue
    account_slug="${account_sign_file##*/id_github_sign_}"
    account_slug="${account_slug%.pub}"
    if [[ ! -r "$SSH_DIR/id_github_auth_$account_slug.pub" ]]; then
      fail "identity '$account_slug' has a signing public key but no auth public key"
      exit_code=1
    fi
  done

  return "$exit_code"
}

# Everything `setup` needs before it starts changing anything. Each failure
# names the exact fix: a half-finished credential setup is worse than one that
# refused to start, because the failure surfaces later as an unexplained
# permission denied.
setup_preflight() {
  local ready=0

  require_safe_machine || ready=1
  require_command op || ready=1
  require_command jq || ready=1
  require_command ssh-add || ready=1
  if [[ "$BACKEND" == "desktop" ]] && ! command -v gh >/dev/null 2>&1; then
    fail "gh is required to publish the public keys to GitHub"
    ready=1
  fi
  require_vault || ready=1
  (( ready == 0 )) || return 1

  # An unlocked app with a known account still needs a signed-in session.
  # Trigger it here rather than making the user re-run setup after doing it by
  # hand -- op signin raises the app's own prompt, so nothing is typed here.
  if [[ "$BACKEND" == "desktop" ]] && ! op whoami >/dev/null 2>&1; then
    if [[ -n "$(op account list 2>/dev/null)" ]] && [[ -t 0 ]]; then
      note "Not signed in. Approve the 1Password prompt..."
      op signin >/dev/null 2>&1 || true
    fi
  fi

  local whoami_output
  if ! whoami_output="$(op_run whoami 2>&1)"; then
    fail "1Password CLI is not authenticated"
    # Show op's own message. Ours names the usual cause; only op knows the
    # actual one, and hiding it makes this the hardest step to debug.
    printf '%s\n' "$whoami_output" | sed 's/^/     /' >&2
    if [[ "$BACKEND" == "desktop" ]]; then
      # Distinguish "no account" from "account known but not signed in": the
      # fixes are completely different, and conflating them sends you to a
      # setting that is already switched on.
      if op account list >/dev/null 2>&1 && [[ -n "$(op account list 2>/dev/null)" ]]; then
        note "The app integration is working -- op can see your account -- but"
        note "this session is not signed in. Run: op signin"
        note "If that fails, quit and reopen 1Password: the app validates the"
        note "op binary at startup and will not have seen a CLI installed since."
      else
        note "op cannot see any account. Turn on 1Password > Settings >"
        note "Developer > 'Integrate with 1Password CLI', and unlock the app."
      fi
      note "Binary in use: $(command -v op 2>/dev/null || echo 'op not found')"
    else
      note "Store the service account token with: dotfiles-keys store-token"
    fi
    return 1
  fi
  pass "1Password CLI is authenticated"

  if ! op_run vault get "$VAULT" >/dev/null 2>&1; then
    fail "cannot read the vault: $VAULT"
    note "Check the name with 'op vault list'. Its ID works too, and avoids"
    note "any trouble with special characters in the name."
    return 1
  fi
  pass "vault is reachable: $VAULT"

  if [[ "$BACKEND" == "desktop" ]]; then
    if ! gh auth status >/dev/null 2>&1; then
      fail "gh is not authenticated; run: gh auth login"
      return 1
    fi
    pass "gh is authenticated"

    # Without this scope `publish` gets half way: the auth key lands on GitHub
    # and the signing key does not. Offer to fix it before creating anything.
    if ! gh auth status 2>&1 | grep -q 'admin:ssh_signing_key'; then
      warn "gh lacks the admin:ssh_signing_key scope, so the signing key cannot be added"
      if [[ -t 0 ]]; then
        local reply
        read -r -p "     Run 'gh auth refresh -h github.com -s admin:ssh_signing_key' now? [y/N] " reply
        if [[ "$reply" =~ ^[Yy] ]]; then
          gh auth refresh -h github.com -s admin:ssh_signing_key || {
            fail "the scope refresh failed"
            return 1
          }
          pass "gh now holds the signing-key scope"
        else
          note "Skipped. The signing key will not be published."
        fi
      else
        note "Fix with: gh auth refresh -h github.com -s admin:ssh_signing_key"
      fi
    fi
  fi

  if ! agent_available; then
    warn "no ssh-agent is reachable; keys can be created but not used yet"
  fi
}

# The whole first-run flow in the right order, so nobody has to remember it.
cmd_setup() {
  printf 'Checking prerequisites\n'
  setup_preflight || return 1

  if [[ "$BACKEND" == "desktop" ]]; then
    printf '\nCreating this machine'"'"'s keys in 1Password\n'
    cmd_generate || return 1

    printf '\nPublishing public keys to GitHub\n'
    cmd_publish || return 1
  else
    note "This service account is read-only; keys must already have been"
    note "provisioned from a desktop-authenticated machine."
  fi

  printf '\nWriting local key files and the trust store\n'
  cmd_sync || return 1

  printf '\nLoading keys into the ssh-agent\n'
  cmd_load || return 1

  cat <<'DONE'

Done. One step left, because it changes managed files:

  chezmoi diff        # review, this machine may have unrelated pending changes
  chezmoi apply       # picks up the new key files for Git and SSH

Then check it worked:

  dotfiles-keys status
  ssh -T git@github.com

Nothing else needs adding to the vault by hand. The only optional extra is a
GitHub token for `gh` on machines that cannot log in interactively -- see
"The GitHub token" in the README; GitHub does not allow creating one via API.
DONE
}

ensure_ssh_item() {
  local item="$1" vault="$2" probe probe_status=0
  probe="$(op_run item get "$item" --vault "$vault" --format json 2>&1)" ||
    probe_status=$?
  if [[ "$probe_status" -eq 0 ]]; then
    pass "already exists in $vault: $item"
    return 0
  fi
  if ! grep -qiE "isn't an item|not found|no item matches" <<<"$probe"; then
    fail "could not determine whether $item exists in $vault"
    printf '%s\n' "$probe" | sed 's/^/     /' >&2
    return 1
  fi
  printf 'Creating %s in %s...\n' "$item" "$vault"
  # 1Password generates the key itself, so the private half is created inside
  # the vault and never exists on this filesystem.
  if op_run item create \
    --category ssh \
    --title "$item" \
    --vault "$vault" \
    --ssh-generate-key ed25519 >/dev/null; then
    pass "created $item"
  else
    fail "could not create $item"
    return 1
  fi
}

github_key_endpoint() {
  case "$1" in
    authentication) printf 'user/keys' ;;
    signing) printf 'user/ssh_signing_keys' ;;
  esac
}

publish_key_to_github() {
  local item="$1" vault="$2" key_type="$3" title="$4"
  local public_key endpoint published key_file exit_code=0

  public_key="$(read_public_key_from "$item" "$vault")"
  if [[ -z "$public_key" ]]; then
    fail "could not read the public key for $item from $vault"
    return 1
  fi

  # Make reruns genuinely idempotent. `gh ssh-key add` reports an already
  # published key as an error, which should not turn successful provisioning
  # into a warning or encourage duplicate items.
  endpoint="$(github_key_endpoint "$key_type")"
  if published="$(gh api --paginate "$endpoint" --jq '.[].key' 2>/dev/null)"; then
    local wanted candidate
    wanted="$(key_body "$public_key")"
    while IFS= read -r candidate; do
      if [[ "$(key_body "$candidate")" == "$wanted" ]]; then
        pass "$key_type key is already on GitHub: $title"
        return 0
      fi
    done <<<"$published"
  else
    warn "could not list existing $key_type keys; attempting to publish"
  fi

  # Public keys are not secrets, but gh wants a file rather than stdin.
  key_file="$(mktemp "${TMPDIR:-/tmp}/dotfiles-keys.XXXXXX")" || return 1
  printf '%s\n' "$public_key" >"$key_file"
  if gh ssh-key add "$key_file" --type "$key_type" --title "$title"; then
    pass "added $key_type key to GitHub: $title"
  else
    fail "could not add the $key_type key"
    exit_code=1
  fi
  rm -f -- "$key_file"
  return "$exit_code"
}

cmd_generate() {
  require_command op || return 1
  require_vault || return 1
  require_safe_machine || return 1

  if [[ "$BACKEND" == "service-account" ]]; then
    fail "refusing to create items with a service account"
    note "The service account is read-only by design. Run this on a personal"
    note "machine signed in to the 1Password app, then 'load' here."
    return 1
  fi

  local item
  for item in "$AUTH_ITEM" "$SIGN_ITEM"; do
    ensure_ssh_item "$item" "$VAULT" || return 1
  done

  note "Next: dotfiles-keys publish, then dotfiles-keys sync"
}

cmd_publish() {
  require_command op || return 1
  require_command gh || return 1
  require_vault || return 1
  require_safe_machine || return 1

  if [[ "$BACKEND" == "service-account" ]]; then
    fail "refusing to publish keys from a service-account machine"
    note "Publish with 'dotfiles-keys provision' from a trusted personal machine."
    return 1
  fi
  if ! gh auth status >/dev/null 2>&1; then
    fail "gh is not authenticated; run: gh auth login"
    return 1
  fi

  local hostname
  hostname="$(uname -n)"

  # Report a real exit status: a caller scripting this needs to know the keys
  # did not reach GitHub, and a silent success here means unverified commits
  # and a machine that cannot authenticate.
  local exit_code=0
  publish_key_to_github "$SIGN_ITEM" "$VAULT" signing "$SIGN_ITEM ($hostname)" || {
    exit_code=1
    note "Signing keys need the admin:ssh_signing_key scope."
    note "Run: gh auth refresh -h github.com -s admin:ssh_signing_key"
  }
  if [[ "$exit_code" -eq 0 ]]; then
    publish_key_to_github "$AUTH_ITEM" "$VAULT" authentication "$AUTH_ITEM ($hostname)" ||
      exit_code=1
  fi
  return "$exit_code"
}

# Write a public key to disk atomically. These are not secrets, but a partially
# written key would make Git and SSH fail in ways that look like a bad key.
write_public_key() {
  local destination="$1" contents="$2" staged
  staged="$(mktemp "${TMPDIR:-/tmp}/dotfiles-key.XXXXXX")" || return 1
  printf '%s\n' "$contents" >"$staged"
  mkdir -p "$SSH_DIR"
  chmod 700 "$SSH_DIR"
  mv -- "$staged" "$destination"
  chmod 644 "$destination"
}

# Bring every locally derived artefact back in line with the vault: this
# machine's two public keys, and the trust store covering all machines.
cmd_sync() {
  require_command op || return 1
  require_vault || return 1
  require_safe_machine || return 1

  local auth_key sign_key
  auth_key="$(read_public_key "$AUTH_ITEM")"
  sign_key="$(read_public_key "$SIGN_ITEM")"

  if [[ -z "$auth_key" || -z "$sign_key" ]]; then
    fail "could not read this machine's public keys from $VAULT"
    note "Expected items: '$AUTH_ITEM' and '$SIGN_ITEM'."
    if [[ "$BACKEND" == "service-account" ]]; then
      note "Provision the default pair from a desktop-authenticated machine."
      note "Run: dotfiles-keys provision $MACHINE --vault '$VAULT'"
    else
      note "Run 'dotfiles-keys generate' on this machine first."
    fi
    return 1
  fi

  write_public_key "$AUTH_KEY_FILE" "$auth_key" || return 1
  write_public_key "$SIGN_KEY_FILE" "$sign_key" || return 1
  pass "wrote this machine's public keys to $SSH_DIR"

  cmd_sync_identities || return 1
  cmd_sync_signers || return 1

  note "Run 'chezmoi apply' so Git and SSH pick the new key files up."
}

# Identity items are read from the vault this machine is configured for, and
# only that vault. That is the scoping mechanism: a machine sees only identities
# deliberately placed inside its trust boundary.
identity_rows_from_json() {
  local items="$1"
  local duplicates
  duplicates="$(jq -r --arg prefix "$IDENTITY_PREFIX" '
    [.[] | select(.title | startswith($prefix + " ("))]
    | group_by(.title)[]
    | select(length > 1)
    | .[0].title
  ' <<<"$items")" || return 1
  if [[ -n "$duplicates" ]]; then
    fail "duplicate git identity titles in $VAULT:"
    printf '%s\n' "$duplicates" | sed 's/^/     /' >&2
    return 1
  fi
  # id<TAB>slug, sorted by slug so overlapping scopes resolve deterministically:
  # when two includeIf rules match, git applies the last one.
  jq -r --arg prefix "$IDENTITY_PREFIX" '
    .[]
    | select(.title | startswith($prefix + " ("))
    | "\(.id)\t\(.title | sub("^" + $prefix + " \\("; "") | sub("\\)$"; ""))"
  ' <<<"$items" | sort -t"$(printf '\t')" -k2
}

identity_rows() {
  require_vault || return 1
  local items
  if ! items="$(vault_items_json)"; then
    fail "could not list items in $VAULT"
    return 1
  fi
  identity_rows_from_json "$items"
}

# --reveal is required for fields stored as CONCEALED. New identities are
# created as plain text below, but items made before that fix are concealed and
# would otherwise read back as "[use 'op item get ...' to reveal]" -- which then
# lands in the gitconfig as if it were an email address.
identity_field() {
  local vault_id
  vault_id="$(resolve_vault_id)" || return 1
  op_run item get "$1" --vault "$vault_id" --fields label="$2" --reveal 2>/dev/null
}

valid_slug() {
  [[ "$1" == [A-Za-z0-9]* ]] && [[ "$1" != *[!A-Za-z0-9._-]* ]]
}

require_safe_machine() {
  if ! valid_slug "$MACHINE"; then
    fail "configured machine name '$MACHINE' is unsafe for key item titles"
    note "Use letters, numbers, dot, underscore and hyphen, starting with a"
    note "letter or number. Fix it with: chezmoi init --prompt"
    return 1
  fi
}

valid_email() {
  # allowed_signers treats `*`, `?`, `!` and comma as pattern syntax. A
  # conservative address grammar keeps an identity email a literal principal.
  [[ "$1" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+$ ]]
}

valid_scope_list() {
  local scope one found=0
  scope="$1"
  while IFS= read -r one; do
    [[ -n "$one" ]] || continue
    [[ "$one" != *[[:space:]]* ]] || return 1
    if ! [[ "$one" =~ ^[A-Za-z0-9_.-]+/(\*\*|[A-Za-z0-9_.-]+)$ ]]; then
      return 1
    fi
    found=1
  done <<<"$scope"
  [[ "$found" -eq 1 ]]
}

# A scope is either "owner/**" for a whole org or "owner/repo" for one repo.
# Emit every URL form git might see, and for an exact repo emit both the bare
# and .git-suffixed variants -- a clone made without the suffix does not match
# a suffixed pattern, which silently drops the identity.
emit_scope_rules() {
  local scope="$1" target="$2" alias_host="${3:-}"
  local prefixes=("git@github.com:" "ssh://git@github.com/" "https://github.com/")
  # A repo cloned through the per-account alias has a different remote URL, so
  # match that too or the identity silently fails to apply to its own repos.
  if [[ -n "$alias_host" ]]; then
    prefixes+=("git@$alias_host:" "ssh://git@$alias_host/")
  fi
  local suffixes=("")
  case "$scope" in
    */\*\*) ;;
    *) suffixes=("" ".git") ;;
  esac
  local prefix suffix
  for prefix in "${prefixes[@]}"; do
    for suffix in "${suffixes[@]}"; do
      printf '[includeIf "hasconfig:remote.*.url:%s%s%s"]\n\tpath = %s\n' \
        "$prefix" "$scope" "$suffix" "$target"
    done
  done
}

# Run on a desktop-authenticated machine signed in to the GitHub account the
# keys should belong to. With no identity this creates the target machine's
# default pair; --identity creates a separate account pair for that identity.
# The legacy positional form `provision <machine> <slug> [vault]` remains
# accepted so existing notes and shell history do not suddenly do the wrong
# thing.
cmd_provision() {
  require_command op || return 1
  require_command gh || return 1
  require_command jq || return 1

  case "${1:-}" in
    -h | --help)
      note "usage: dotfiles-keys provision <machine> [--identity <slug>]"
      note "       [--vault <vault>] [--github-user <login>]"
      return 0
      ;;
    "")
      fail "usage: dotfiles-keys provision <machine> [--identity <slug>]"
      note "       [--vault <vault>] [--github-user <login>]"
      return 2
      ;;
    -*)
      fail "machine name cannot be an option: $1"
      return 2
      ;;
  esac

  local machine="${1:-}"
  shift
  local slug="" vault="$VAULT" expected_user=""
  local identity_set=0 vault_set=0 github_user_set=0

  while (($# > 0)); do
    case "$1" in
      --identity)
        if [[ "$identity_set" -eq 1 || $# -lt 2 || -z "$2" || "$2" == -* ]]; then
          fail "--identity needs exactly one slug"
          return 2
        fi
        slug="$2"
        identity_set=1
        shift 2
        ;;
      --vault)
        if [[ "$vault_set" -eq 1 || $# -lt 2 || -z "$2" || "$2" == -* ]]; then
          fail "--vault needs exactly one vault name or ID"
          return 2
        fi
        vault="$2"
        vault_set=1
        shift 2
        ;;
      --github-user)
        if [[ "$github_user_set" -eq 1 || $# -lt 2 || -z "$2" || "$2" == -* ]]; then
          fail "--github-user needs exactly one login"
          return 2
        fi
        expected_user="$2"
        github_user_set=1
        shift 2
        ;;
      -h | --help)
        note "usage: dotfiles-keys provision <machine> [--identity <slug>]"
        note "       [--vault <vault>] [--github-user <login>]"
        return 0
        ;;
      -*)
        fail "unknown provision option: $1"
        return 2
        ;;
      *)
        # Backwards compatibility: the old command used positional slug and
        # vault arguments. A default pair has no positional arguments.
        if [[ "$identity_set" -eq 0 ]]; then
          slug="$1"
          identity_set=1
        elif [[ "$vault_set" -eq 0 ]]; then
          vault="$1"
          vault_set=1
        else
          fail "too many provision arguments"
          return 2
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$machine" || -z "$vault" ]]; then
    fail "usage: dotfiles-keys provision <machine> [--identity <slug>]"
    note "       [--vault <vault>] [--github-user <login>]"
    return 1
  fi
  if ! valid_slug "$machine"; then
    fail "machine names must start with a letter or number and contain only"
    note "letters, numbers, dot, underscore and hyphen"
    return 1
  fi
  if [[ "$identity_set" -eq 1 ]] && ! valid_slug "$slug"; then
    fail "identity slugs must start with a letter or number and contain only"
    note "letters, numbers, dot, underscore and hyphen"
    return 1
  fi
  if [[ "$github_user_set" -eq 1 && "$expected_user" == *[[:space:]]* ]]; then
    fail "GitHub login cannot contain whitespace"
    return 1
  fi
  if [[ "$BACKEND" == "service-account" ]]; then
    fail "refusing to create items with a read-only service account"
    note "Run provision on a machine authenticated through the 1Password app."
    return 1
  fi
  if ! gh auth status >/dev/null 2>&1; then
    fail "gh is not authenticated; run: gh auth login"
    return 1
  fi

  local account
  account="$(gh api user --jq .login 2>/dev/null)"
  if [[ -z "$account" ]]; then
    fail "could not identify the active GitHub account"
    return 1
  fi
  local normalized_account normalized_expected_user
  normalized_account="$(tr '[:upper:]' '[:lower:]' <<<"$account")"
  normalized_expected_user="$(tr '[:upper:]' '[:lower:]' <<<"$expected_user")"
  if [[ "$github_user_set" -eq 1 ]] &&
    [[ "$normalized_account" != "$normalized_expected_user" ]]; then
    fail "active GitHub account is '$account', expected '$expected_user'"
    note "Switch first: gh auth switch -h github.com -u $expected_user"
    return 1
  fi
  note "Publishing to GitHub account: $account"

  local kind title
  for kind in auth sign; do
    if [[ -n "$slug" ]]; then
      title="$(account_item_title "$kind" "$machine" "$slug")"
    else
      title="$(machine_item_title "$kind" "$machine")"
    fi
    ensure_ssh_item "$title" "$vault" || return 1
  done

  # Publish to whichever account gh is logged in as -- that is the whole point
  # of running this here rather than on the target machine. Publish signing
  # first: a missing signing-key scope then fails before an auth-only setup.
  local key_type exit_code=0
  for kind in sign auth; do
    if [[ -n "$slug" ]]; then
      title="$(account_item_title "$kind" "$machine" "$slug")"
    else
      title="$(machine_item_title "$kind" "$machine")"
    fi
    [[ "$kind" == auth ]] && key_type=authentication || key_type=signing
    publish_key_to_github "$title" "$vault" "$key_type" "$title" || {
      exit_code=1
      [[ "$kind" == sign ]] &&
        note "Signing keys need: gh auth refresh -h github.com -s admin:ssh_signing_key"
      break
    }
  done

  if [[ "$exit_code" -eq 0 ]]; then
    note "On $machine, run: dotfiles-keys sync && dotfiles-keys load"
  fi
  return "$exit_code"
}

cmd_sync_identities() {
  require_command op || return 1
  require_command jq || return 1
  require_vault || return 1

  local items rows
  if ! items="$(vault_items_json)"; then
    fail "could not list items in $VAULT"
    return 1
  fi
  rows="$(identity_rows_from_json "$items")" || return 1

  local staged_root staged_include staged_identity_dir staged_ssh_dir
  staged_root="$(mktemp -d "${TMPDIR:-/tmp}/identity-sync.XXXXXX")" || return 1
  staged_include="$staged_root/identities.gitconfig"
  staged_identity_dir="$staged_root/identities"
  staged_ssh_dir="$staged_root/ssh"
  mkdir -p "$staged_identity_dir" "$staged_ssh_dir/config.d"

  {
    printf '# Generated by dotfiles-keys sync. Edits are lost.\n'
    printf '# Identities come from the 1Password vault: %s\n\n' "$VAULT"
  } >"$staged_include"

  local item_id slug email scope count=0
  while IFS="$(printf '\t')" read -r item_id slug; do
    [[ -n "$item_id" ]] || continue
    if ! valid_slug "$slug"; then
      fail "identity slug '$slug' is unsafe; use letters, numbers, dot, underscore or hyphen"
      rm -rf -- "$staged_root"
      return 1
    fi
    if ! email="$(identity_field "$item_id" "$IDENTITY_EMAIL_FIELD")" ||
      ! scope="$(identity_field "$item_id" "$IDENTITY_SCOPE_FIELD")"; then
      fail "could not read identity '$slug'; existing routing was kept"
      rm -rf -- "$staged_root"
      return 1
    fi
    if [[ -z "$email" || -z "$scope" ]]; then
      warn "skipping identity '$slug': needs both $IDENTITY_EMAIL_FIELD and $IDENTITY_SCOPE_FIELD"
      continue
    fi
    if ! valid_email "$email"; then
      fail "identity '$slug' has an invalid email address"
      rm -rf -- "$staged_root"
      return 1
    fi
    if ! valid_scope_list "$scope"; then
      fail "identity '$slug' has an invalid scope; use owner/** or owner/repo"
      rm -rf -- "$staged_root"
      return 1
    fi

    # Does this identity own credentials on a separate GitHub account? The
    # presence of its key items in the vault is the signal -- nothing to
    # configure, `provision` simply creates them.
    local alias_host="" auth_title sign_title auth_id sign_id auth_key sign_key
    auth_title="$(account_item_title auth "$MACHINE" "$slug")"
    sign_title="$(account_item_title sign "$MACHINE" "$slug")"
    if ! auth_id="$(item_id_from_json "$items" "$auth_title")" ||
      ! sign_id="$(item_id_from_json "$items" "$sign_title")"; then
      rm -rf -- "$staged_root"
      return 1
    fi
    if { [[ -n "$auth_id" ]] && [[ -z "$sign_id" ]]; } ||
      { [[ -z "$auth_id" ]] && [[ -n "$sign_id" ]]; }; then
      fail "identity '$slug' has only one account key in $VAULT"
      note "Expected both '$auth_title' and '$sign_title'; existing routing was kept."
      rm -rf -- "$staged_root"
      return 1
    fi
    if [[ -n "$auth_id" && -n "$sign_id" ]]; then
      auth_key="$(read_public_key "$auth_id")"
      sign_key="$(read_public_key "$sign_id")"
      if [[ -z "$auth_key" || -z "$sign_key" ]]; then
        fail "could not read both account keys for identity '$slug'"
        rm -rf -- "$staged_root"
        return 1
      fi
      alias_host="github-$slug"
      printf '%s\n' "$auth_key" >"$staged_ssh_dir/id_github_auth_$slug.pub"
      printf '%s\n' "$sign_key" >"$staged_ssh_dir/id_github_sign_$slug.pub"
      chmod 644 "$staged_ssh_dir/id_github_auth_$slug.pub" "$staged_ssh_dir/id_github_sign_$slug.pub"
      cat >"$staged_ssh_dir/config.d/10-$slug.conf" <<SSHCONF
# Generated by dotfiles-keys sync. Edits are lost.
Host $alias_host
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_github_auth_$slug.pub
  IdentitiesOnly yes
SSHCONF
      chmod 600 "$staged_ssh_dir/config.d/10-$slug.conf"
    fi

    {
      printf '[user]\n\tname = %s\n\temail = %s\n' "$GIT_NAME" "$email"
      # Sign with this account's own key: a key registered on a different
      # GitHub account cannot verify a commit authored under this email.
      if [[ -n "$alias_host" ]]; then
        printf '[user]\n\tsigningkey = ~/.ssh/id_github_sign_%s.pub\n' "$slug"
      fi
    } >"$staged_identity_dir/$slug.gitconfig"
    chmod 600 "$staged_identity_dir/$slug.gitconfig"

    # One item may carry several scopes, one per line.
    local one
    while IFS= read -r one; do
      one="${one//[[:space:]]/}"
      [[ -n "$one" ]] || continue
      emit_scope_rules "$one" "$IDENTITY_DIR/$slug.gitconfig" "$alias_host" >>"$staged_include"
    done <<<"$scope"
    count=$((count + 1))
  done <<<"$rows"

  # Validation and all vault reads completed before this point. Replace the
  # generated state wholesale so an incomplete pair or transient vault error
  # cannot erase the last working routing.
  mkdir -p "$SSH_DIR" "$(dirname "$IDENTITY_INCLUDE")"
  chmod 700 "$SSH_DIR"
  local old_key staged_key
  for old_key in \
    "$SSH_DIR"/id_github_auth_*.pub \
    "$SSH_DIR"/id_github_sign_*.pub; do
    [[ -e "$old_key" ]] && rm -f -- "$old_key"
  done
  for staged_key in \
    "$staged_ssh_dir"/id_github_auth_*.pub \
    "$staged_ssh_dir"/id_github_sign_*.pub; do
    [[ -e "$staged_key" ]] && mv -- "$staged_key" "$SSH_DIR/"
  done

  rm -rf -- "$SSH_INCLUDE_DIR"
  mv -- "$staged_ssh_dir/config.d" "$SSH_INCLUDE_DIR"
  chmod 700 "$SSH_INCLUDE_DIR"

  rm -rf -- "$IDENTITY_DIR"
  mv -- "$staged_identity_dir" "$IDENTITY_DIR"
  mv -- "$staged_include" "$IDENTITY_INCLUDE"
  rm -rf -- "$staged_root"
  chmod 600 "$IDENTITY_INCLUDE"

  pass "wrote $count git identity(ies) from $VAULT"
}

cmd_identity_add() {
  require_command op || return 1
  require_command jq || return 1

  case "${1:-}" in
    -h | --help)
      note "usage: dotfiles-keys identity-add <slug> <email> <owner/** | owner/repo>"
      note "       [--vault <vault>]"
      return 0
      ;;
  esac

  local slug="${1:-}" email="${2:-}" scope="${3:-}"
  if (($# >= 3)); then
    shift 3
  else
    set --
  fi
  local vault="$VAULT" vault_set=0
  while (($# > 0)); do
    case "$1" in
      --vault)
        if [[ "$vault_set" -eq 1 || $# -lt 2 ]]; then
          fail "--vault needs exactly one vault name or ID"
          return 2
        fi
        vault="$2"
        vault_set=1
        shift 2
        ;;
      -h | --help)
        note "usage: dotfiles-keys identity-add <slug> <email> <owner/** | owner/repo>"
        note "       [--vault <vault>]"
        return 0
        ;;
      *)
        fail "unknown identity-add option or argument: $1"
        return 2
        ;;
    esac
  done

  if [[ -z "$slug" || -z "$email" || -z "$scope" ]]; then
    fail "usage: dotfiles-keys identity-add <slug> <email> <owner/** | owner/repo>"
    note "       [--vault <vault>]"
    return 1
  fi
  if [[ -z "$vault" ]]; then
    fail "no target vault; pass --vault or run: chezmoi init --prompt"
    return 1
  fi
  if ! valid_slug "$slug"; then
    fail "identity slugs may contain only letters, numbers, dot, underscore and hyphen"
    return 1
  fi
  if ! valid_email "$email"; then
    fail "identity email is not valid: $email"
    return 1
  fi
  if ! valid_scope_list "$scope"; then
    fail "identity scope must be owner/** or owner/repo"
    return 1
  fi
  if [[ "$BACKEND" == "service-account" ]]; then
    fail "refusing to create items with a read-only service account"
    note "Add the identity from a machine signed in to the 1Password app."
    return 1
  fi

  # [text] matters: without it op stores these as CONCEALED, and reading them
  # back yields a placeholder rather than the value. Neither an email nor a
  # repo glob is a secret.
  local title="$IDENTITY_PREFIX ($slug)"
  local existing="" probe probe_status=0
  probe="$(op_run item get "$title" --vault "$vault" --format json 2>&1)" ||
    probe_status=$?
  if [[ "$probe_status" -eq 0 ]]; then
    existing="$(jq -r '.id // empty' <<<"$probe")"
    if [[ -z "$existing" ]]; then
      fail "the existing identity item has no ID: $title"
      return 1
    fi
  elif ! grep -qiE "isn't an item|not found|no item matches" <<<"$probe"; then
    fail "could not determine whether $title exists in $vault"
    printf '%s\n' "$probe" | sed 's/^/     /' >&2
    return 1
  fi

  if [[ -n "$existing" ]]; then
    # Update rather than create: a second item with the same title makes every
    # later lookup ambiguous and silently duplicates the routing rules.
    if op_run item edit "$existing" \
      --vault "$vault" \
      "${IDENTITY_EMAIL_FIELD}[text]=$email" \
      "${IDENTITY_SCOPE_FIELD}[text]=$scope" >/dev/null; then
      pass "updated $title in $vault"
    else
      fail "could not update the existing identity item"
      return 1
    fi
  elif op_run item create \
    --category "Secure Note" \
    --title "$title" \
    --vault "$vault" \
    "${IDENTITY_EMAIL_FIELD}[text]=$email" \
    "${IDENTITY_SCOPE_FIELD}[text]=$scope" >/dev/null; then
    pass "created $title in $vault"
  else
    fail "could not create the identity item"
    return 1
  fi

  # A foreign-vault write provisions another machine. Do not rewrite this
  # machine's local routing from its own, different trust boundary.
  local sync_local=0 target_vault_id configured_vault_id
  if [[ "$vault" == "$VAULT" ]]; then
    sync_local=1
  elif [[ -n "$VAULT" ]]; then
    target_vault_id="$(op_run vault get "$vault" --format json 2>/dev/null |
      jq -r '.id // empty')"
    configured_vault_id="$(resolve_vault_id 2>/dev/null || true)"
    [[ -n "$target_vault_id" && "$target_vault_id" == "$configured_vault_id" ]] &&
      sync_local=1
  fi

  if [[ "$sync_local" -eq 1 ]]; then
    cmd_sync_identities || return 1
    # The trust store lists principals, and a new identity adds one. Skipping
    # this would leave its commits unverifiable until the next unrelated sync.
    cmd_sync_signers
  else
    note "Identity stored for another vault; local routing was left unchanged."
    note "On machines using $vault, run: dotfiles-keys sync"
  fi
}

# The vault is the only place that knows how many machines exist, so the trust
# store is rebuilt from it rather than templated from this machine's data.
# Otherwise a commit signed on one machine would not verify on another.
cmd_sync_signers() {
  require_command op || return 1
  require_command jq || return 1
  require_vault || return 1
  require_safe_machine || return 1

  if ! valid_email "$DEFAULT_EMAIL"; then
    fail "default email is not a safe SSH signing principal: $DEFAULT_EMAIL"
    return 1
  fi

  # The configured vault is the trust boundary for both identities and keys.
  # Mixing keys from every desktop-readable vault with emails from only this
  # vault would assign foreign keys to the wrong principals.
  local items
  if ! items="$(op_run item list \
    --categories "SSH Key" \
    --vault "$VAULT" \
    --format json 2>/dev/null)"; then
    fail "could not list SSH key items in 1Password"
    return 1
  fi

  local duplicate_titles
  duplicate_titles="$(jq -r --arg prefix "$SIGN_ITEM_PREFIX" '
    [.[] | select(.title | startswith($prefix + " ("))]
    | group_by(.title)[]
    | select(length > 1)
    | .[0].title
  ' <<<"$items")"
  if [[ -n "$duplicate_titles" ]]; then
    fail "duplicate signing-key titles in $VAULT:"
    printf '%s\n' "$duplicate_titles" | sed 's/^/     /' >&2
    return 1
  fi

  # id<TAB>title within the configured vault.
  local rows
  rows="$(jq -r --arg prefix "$SIGN_ITEM_PREFIX" \
    '.[] | select(.title | startswith($prefix + " (")) | "\(.id)\t\(.title)"' <<<"$items" |
    sort -t"$(printf '\t')" -k2)"

  if [[ -z "$rows" ]]; then
    fail "no items named '$SIGN_ITEM_PREFIX (...)' are readable"
    note "Run 'dotfiles-keys generate' on at least one machine first."
    return 1
  fi

  # Keep a slug-to-email map for account-specific signing keys. Trusting every
  # key for every email would let a key registered to one GitHub account verify
  # locally as another identity.
  local identity_data="" identity_rows_data identity_id slug email
  identity_rows_data="$(identity_rows)" || return 1
  while IFS="$(printf '\t')" read -r identity_id slug; do
    [[ -n "$identity_id" ]] || continue
    if ! email="$(identity_field "$identity_id" "$IDENTITY_EMAIL_FIELD")"; then
      fail "could not read the email for identity '$slug'; trust store was kept"
      return 1
    fi
    if ! valid_slug "$slug" || ! valid_email "$email"; then
      fail "identity '$slug' is not safe for the signing trust store"
      return 1
    fi
    identity_data+="${identity_data:+$'\n'}$slug"$'\t'"$email"
  done <<<"$identity_rows_data"

  local staged
  staged="$(mktemp "${TMPDIR:-/tmp}/allowed-signers.XXXXXX")" || return 1

  local item_id title key principal count=0 mapping_count=0
  while IFS="$(printf '\t')" read -r item_id title; do
    [[ -n "$item_id" ]] || continue
    if [[ "$BACKEND" == "service-account" ]]; then
      if ! key="$(op_run item get "$item_id" --vault "$VAULT" \
        --fields label="$PUBLIC_FIELD" 2>/dev/null)"; then
        fail "could not read $title; trust store was kept"
        rm -f -- "$staged"
        return 1
      fi
    else
      if ! key="$(op_run item get "$item_id" \
        --fields label="$PUBLIC_FIELD" 2>/dev/null)"; then
        fail "could not read $title; trust store was kept"
        rm -f -- "$staged"
        return 1
      fi
    fi
    if [[ -z "$key" ]]; then
      fail "$title has an empty public key; trust store was kept"
      rm -f -- "$staged"
      return 1
    fi

    local item_principals="" matched_slug="" mapped_slug mapped_email machine inner
    inner="${title#"$SIGN_ITEM_PREFIX ("}"
    inner="${inner%)}"
    while IFS="$(printf '\t')" read -r mapped_slug mapped_email; do
      [[ -n "$mapped_slug" ]] || continue
      machine="${inner% "$mapped_slug"}"
      if [[ "$inner" == *" $mapped_slug" ]] && valid_slug "$machine"; then
        matched_slug="$mapped_slug"
        item_principals="$mapped_email"
        break
      fi
    done <<<"$identity_data"

    if [[ -z "$matched_slug" ]]; then
      if ! valid_slug "$inner"; then
        warn "skipping $title: it is neither a valid base title nor a known identity key"
        continue
      fi
      # A base key signs the default identity and any scoped identity that does
      # not have its own signing key for this same machine.
      item_principals="$DEFAULT_EMAIL"
      machine="$inner"
      while IFS="$(printf '\t')" read -r mapped_slug mapped_email; do
        [[ -n "$mapped_slug" ]] || continue
        if ! item_title_exists_in_json "$items" \
          "$(account_item_title sign "$machine" "$mapped_slug")"; then
          item_principals+="${item_principals:+$'\n'}$mapped_email"
        fi
      done <<<"$identity_data"
    fi

    if [[ -z "$item_principals" ]]; then
      warn "skipping $title: no matching identity email is readable"
      continue
    fi
    while IFS= read -r principal; do
      [[ -n "$principal" ]] || continue
      printf '%s %s\n' "$principal" "$key" >>"$staged"
      mapping_count=$((mapping_count + 1))
    done <<<"$item_principals"
    count=$((count + 1))
  done <<<"$rows"

  if ((count == 0)); then
    fail "no signing keys could be read; leaving $ALLOWED_SIGNERS untouched"
    rm -f -- "$staged"
    return 1
  fi

  # Replace atomically: a half-written trust store would make every signature
  # fail to verify.
  local sorted
  sorted="$(mktemp "${TMPDIR:-/tmp}/allowed-signers-sorted.XXXXXX")" || {
    rm -f -- "$staged"
    return 1
  }
  sort -u "$staged" >"$sorted"
  rm -f -- "$staged"
  mkdir -p "$(dirname "$ALLOWED_SIGNERS")"
  chmod 700 "$(dirname "$ALLOWED_SIGNERS")"
  mv -- "$sorted" "$ALLOWED_SIGNERS"
  chmod 600 "$ALLOWED_SIGNERS"
  pass "trusted $count signing key(s) across $mapping_count identity mapping(s)"
}

cmd_load() {
  require_command op || return 1
  require_command jq || return 1
  require_command ssh-add || return 1
  require_vault || return 1
  require_safe_machine || return 1

  if ! agent_available; then
    fail "no ssh-agent is reachable; cannot load keys"
    return 1
  fi

  local items identity_rows_data
  if ! items="$(vault_items_json)"; then
    fail "could not list items in $VAULT"
    return 1
  fi
  identity_rows_data="$(identity_rows_from_json "$items")" || return 1

  local item_ids=() item_titles=()
  local item item_id exit_code=0
  for item in "$AUTH_ITEM" "$SIGN_ITEM"; do
    if ! item_id="$(item_id_from_json "$items" "$item")"; then
      exit_code=1
      continue
    elif [[ -z "$item_id" ]]; then
      fail "could not find $item in $VAULT"
      exit_code=1
    else
      item_ids+=("$item_id")
      item_titles+=("$item")
    fi
  done

  # A complete identity-specific pair belongs in the same agent as the default
  # pair. `sync` already writes the matching public files and host alias; not
  # loading these private halves made that configuration unusable after reboot.
  local identity_id slug auth_title sign_title auth_id sign_id
  while IFS="$(printf '\t')" read -r identity_id slug; do
    [[ -n "$identity_id" ]] || continue
    if ! valid_slug "$slug"; then
      fail "identity slug '$slug' is unsafe"
      exit_code=1
      continue
    fi
    auth_title="$(account_item_title auth "$MACHINE" "$slug")"
    sign_title="$(account_item_title sign "$MACHINE" "$slug")"
    if ! auth_id="$(item_id_from_json "$items" "$auth_title")" ||
      ! sign_id="$(item_id_from_json "$items" "$sign_title")"; then
      exit_code=1
      continue
    fi
    if [[ -z "$auth_id" && -z "$sign_id" ]]; then
      continue
    fi
    if [[ -z "$auth_id" || -z "$sign_id" ]]; then
      fail "identity '$slug' has only one account key; refusing a partial load"
      exit_code=1
      continue
    fi
    item_ids+=("$auth_id" "$sign_id")
    item_titles+=("$auth_title" "$sign_title")
  done <<<"$identity_rows_data"

  local error_log
  error_log="$(mktemp "${TMPDIR:-/tmp}/dotfiles-keys-err.XXXXXX")" || return 1

  local index
  for ((index = 0; index < ${#item_ids[@]}; index++)); do
    item_id="${item_ids[$index]}"
    item="${item_titles[$index]}"
    local private_key
    # The key exists only in this variable and the agent. It is never written
    # to a file, so there is nothing left behind to clean up or to leak.
    #
    # op's stderr goes to its own file rather than being folded into stdout:
    # merging them would splice a warning or progress line into the middle of
    # the private key and ssh-add would reject a key that is actually fine.
    : >"$error_log"
    if ! private_key="$(op_run read "$(reference "$item_id" "$PRIVATE_REFERENCE_SUFFIX")" 2>"$error_log")"; then
      fail "could not read $item from $VAULT"
      sed 's/^/     /' "$error_log" >&2
      exit_code=1
      continue
    fi
    # A lifetime bounds how long a revoked service account keeps working, which
    # only applies to work machines. Expiring the key on a personal machine
    # would just strand any unattended process that signs after it lapses.
    local add_args=()
    [[ "$BACKEND" == "service-account" ]] && add_args=(-t "$KEY_LIFETIME")
    # macOS ships bash 3.2, where expanding an empty array under `set -u` is an
    # unbound-variable error rather than nothing.
    if printf '%s\n' "$private_key" | ssh-add ${add_args[@]+"${add_args[@]}"} - 2>/dev/null; then
      if [[ "$BACKEND" == "service-account" ]]; then
        pass "loaded $item for $KEY_LIFETIME"
      else
        pass "loaded $item until logout"
      fi
    else
      fail "ssh-add rejected the key for $item"
      exit_code=1
    fi
    unset private_key
  done

  rm -f -- "$error_log"
  return "$exit_code"
}

cmd_unload() {
  require_command ssh-add || return 1

  local key key_file removed=0 failed=0 recorded=0
  for key_file in \
    "$AUTH_KEY_FILE" \
    "$SIGN_KEY_FILE" \
    "$SSH_DIR"/id_github_auth_*.pub \
    "$SSH_DIR"/id_github_sign_*.pub; do
    [[ -e "$key_file" ]] || continue
    key="$(recorded_key "$key_file")"
    [[ -n "$key" ]] || continue
    recorded=$((recorded + 1))
    if agent_holds_key "$key"; then
      if printf '%s\n' "$key" | ssh-add -d - >/dev/null 2>&1; then
        removed=$((removed + 1))
      else
        # Reporting "nothing was loaded" here would tell the user the agent is
        # clean when it is still holding a usable key.
        fail "the agent still holds a key that could not be removed"
        failed=$((failed + 1))
      fi
    fi
  done

  if (( failed > 0 )); then
    return 1
  fi
  if (( removed > 0 )); then
    pass "removed $removed key(s) from the agent"
  elif (( recorded == 0 )); then
    warn "no public keys are recorded, so nothing could be matched; run: dotfiles-keys sync"
  else
    note "no managed keys were loaded"
  fi
}

cmd_store_token() {
  if [[ "$BACKEND" != "service-account" ]]; then
    fail "only work machines need a service account token"
    note "Personal machines authenticate as you through the 1Password app."
    return 1
  fi
  if ! command -v security >/dev/null 2>&1; then
    fail "the macOS keychain is unavailable on this host"
    note "Write the token to $TOKEN_FILE with mode 0600 instead."
    return 1
  fi

  note "Paste the 1Password service account token when prompted."
  note "It is not echoed, and never appears in argv, ps output or shell history."
  # -w LAST and with no value makes security prompt on the terminal, which is
  # the only form that keeps the token out of the process list.
  if security add-generic-password \
    -U \
    -a "$USER" \
    -s "$KEYCHAIN_SERVICE" \
    -D "1Password service account token" \
    -j "Used by dotfiles-keys on this work machine" \
    -w; then
    pass "stored the token in the login keychain as '$KEYCHAIN_SERVICE'"
  else
    fail "could not store the token"
    return 1
  fi

  if [[ -e "$TOKEN_FILE" ]]; then
    warn "a plaintext token still exists at $TOKEN_FILE"
    note "The keychain now takes precedence. Delete the file once you have"
    note "confirmed 'dotfiles-keys status' works."
  fi
}

cmd_token() {
  # Callers do `GH_TOKEN="$(dotfiles-keys token)"`, so stdout carries the token
  # and nothing else. Keep every prerequisite diagnostic on stderr.
  { require_command op && require_vault; } >&2 || return 1

  local token_item_id
  if ! token_item_id="$(resolve_item_id "$TOKEN_ITEM")" || [[ -z "$token_item_id" ]]; then
    fail "could not find $TOKEN_ITEM in $VAULT" >&2
    return 1
  fi
  if ! op_run read --no-newline "$(reference "$token_item_id" "$TOKEN_FIELD")"; then
    fail "could not read $TOKEN_ITEM from $VAULT"
    return 1
  fi
}

main() {
  local command="${1:-status}"
  case "$command" in
    setup) cmd_setup ;;
    provision)
      shift
      cmd_provision "$@"
      ;;
    store-token) cmd_store_token ;;
    status) cmd_status ;;
    generate) cmd_generate ;;
    publish) cmd_publish ;;
    sync) cmd_sync ;;
    sync-identities) cmd_sync_identities ;;
    identity-add)
      shift
      cmd_identity_add "$@"
      ;;
    sync-signers) cmd_sync_signers ;;
    load) cmd_load ;;
    unload) cmd_unload ;;
    token) cmd_token ;;
    -h | --help | help) usage ;;
    *)
      fail "unknown command: $command"
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"

#!/bin/sh

if [ -z "${__BRADEN_SHELL_START_REAL:-}" ]; then
  if command -v perl >/dev/null 2>&1; then
    __BRADEN_SHELL_START_REAL="$(perl -MTime::HiRes=time -e 'printf "%.6f\n", time')"
  elif command -v python3 >/dev/null 2>&1; then
    __BRADEN_SHELL_START_REAL="$(python3 -c 'import time; print(f"{time.time():.6f}")')"
  fi

  export __BRADEN_SHELL_START_REAL
fi

if fish_path="$(command -v fish 2>/dev/null)"; then
  exec "$fish_path" "$@"
fi

for candidate in /opt/homebrew/bin/fish /usr/local/bin/fish /opt/local/bin/fish; do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

echo "fish is not installed or not on PATH" >&2
exit 127

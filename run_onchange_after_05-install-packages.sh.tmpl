#!/bin/bash
set -euo pipefail

# Brewfile source hash: {{ include "dot_config/homebrew/Brewfile" | sha256sum }}
if [[ "{{ .chezmoi.os }}" != "darwin" ]]; then
  echo "Homebrew dependency installation is macOS-only; skipping."
  exit 0
fi

export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_REQUIRE_TAP_TRUST=1

find_brew() {
  if command -v brew >/dev/null 2>&1; then
    command -v brew
  elif [[ -x /opt/homebrew/bin/brew ]]; then
    printf '%s\n' /opt/homebrew/bin/brew
  elif [[ -x /usr/local/bin/brew ]]; then
    printf '%s\n' /usr/local/bin/brew
  fi
}

BREW_BIN="$(find_brew || true)"
BREWFILE="{{ .chezmoi.homeDir }}/.config/homebrew/Brewfile"

if [[ -z "$BREW_BIN" ]]; then
  echo "Homebrew is unavailable; re-run chezmoi apply after installing it." >&2
  exit 1
fi
if [[ ! -r "$BREWFILE" ]]; then
  echo "Managed Brewfile is missing: $BREWFILE" >&2
  exit 1
fi

# Homebrew taps execute third-party Ruby. Fail closed if a future Brewfile adds
# a tap without an explicit review here.
while IFS= read -r tap_name; do
  case "$tap_name" in
    withgraphite/tap) ;;
    *)
      echo "Refusing unreviewed Homebrew tap: $tap_name" >&2
      echo "Add it to this hook's trusted-tap allowlist after reviewing it." >&2
      exit 1
      ;;
  esac
done < <(sed -nE 's/^[[:space:]]*tap[[:space:]]+"([^"]+)".*/\1/p' "$BREWFILE")

"$BREW_BIN" analytics off >/dev/null
"$BREW_BIN" trust --tap withgraphite/tap
if "$BREW_BIN" bundle check --file="$BREWFILE" --no-upgrade >/dev/null 2>&1; then
  echo "Homebrew dependencies are already present."
  exit 0
fi

echo "Installing missing Homebrew dependencies..."
"$BREW_BIN" bundle install --file="$BREWFILE" --no-upgrade
echo "Homebrew dependency installation complete."

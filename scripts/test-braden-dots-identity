#!/usr/bin/env bash

# Behaviorally exercise `braden-dots identity` without talking to 1Password, GitHub, the
# Keychain, or a real ssh-agent. The helper is rendered exactly as it is for a
# machine; only its external commands are replaced with stateful fakes.

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
chezmoi_bin=${CHEZMOI_BIN:-chezmoi}
command -v "$chezmoi_bin" >/dev/null 2>&1 || {
	echo "chezmoi is required" >&2
	exit 1
}
command -v jq >/dev/null 2>&1 || {
	echo "jq is required" >&2
	exit 1
}

temp_root=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-keys-test.XXXXXX")
trap 'rm -rf "$temp_root"' EXIT INT TERM

fake_bin="$temp_root/bin"
mkdir -p "$fake_bin"

fail() {
	printf 'FAIL: %s\n' "$*" >&2
	exit 1
}

assert_eq() {
	local expected=$1 actual=$2 message=$3
	if [[ "$actual" != "$expected" ]]; then
		printf 'FAIL: %s\n  expected: %s\n  actual:   %s\n' \
			"$message" "$expected" "$actual" >&2
		exit 1
	fi
}

assert_contains() {
	local file=$1 text=$2 message=$3
	if ! grep -Fq -- "$text" "$file"; then
		printf 'FAIL: %s\n  missing: %s\n  file: %s\n' \
			"$message" "$text" "$file" >&2
		exit 1
	fi
}

assert_not_contains() {
	local file=$1 text=$2 message=$3
	if grep -Fq -- "$text" "$file"; then
		printf 'FAIL: %s\n  unexpected text in: %s\n' "$message" "$file" >&2
		exit 1
	fi
}

assert_tokens_not_logged() {
	local log token_value
	for log in "$FAKE_STATE/op-calls" "$FAKE_STATE/gh-calls" \
		"$FAKE_STATE/gh-contexts" "$FAKE_STATE/gh-adds" "$FAKE_STATE/ssh-adds"; do
		for token_value in \
			fixture-default-correct \
			fixture-scoped-correct \
			fixture-scoped-wrong \
			fixture-legacy; do
			assert_not_contains "$log" "$token_value" \
				"credential values must never be written to command logs"
		done
	done
}

item_count() {
	local title=$1 vault=$2
	awk -F'|' -v title="$title" -v vault="$vault" \
		'$3 == title && $4 == vault { count++ } END { print count + 0 }' \
		"$FAKE_STATE/items"
}

seed_item() {
	local id=$1 category=$2 title=$3 vault=$4 public_key=$5
	local email=${6:-} scope=${7:-} username=${8:-} credential=${9:-}
	printf '%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
		"$id" "$category" "$title" "$vault" "$public_key" "$email" "$scope" \
		"$username" "$credential" \
		>>"$FAKE_STATE/items"
}

new_case() {
	local name=$1
	FAKE_STATE="$temp_root/cases/$name"
	export FAKE_STATE
	mkdir -p "$FAKE_STATE"
	: >"$FAKE_STATE/items"
	: >"$FAKE_STATE/op-calls"
	: >"$FAKE_STATE/gh-calls"
	: >"$FAKE_STATE/gh-contexts"
	: >"$FAKE_STATE/gh-adds"
	: >"$FAKE_STATE/ssh-adds"
	unset FAKE_GH_FAIL_TYPE
	unset FAKE_GH_USER
	unset FAKE_OP_FAIL_FIELD
	unset FAKE_EXPECT_DESKTOP_AUTH_ONLY
	unset GH_TOKEN
	unset GITHUB_TOKEN
}

# ---------------------------------------------------------------------------
# Fake external commands
# ---------------------------------------------------------------------------

cat >"$fake_bin/op" <<'FAKE_OP'
#!/usr/bin/env bash
set -uo pipefail

if [[ "${FAKE_EXPECT_DESKTOP_AUTH_ONLY:-0}" == 1 ]] &&
	[[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}${OP_CONNECT_HOST:-}${OP_CONNECT_TOKEN:-}" ]]; then
	printf 'ambient non-desktop authentication reached op\n' >&2
	exit 97
fi

log_call() {
	local separator=""
	local argument
	for argument in "$@"; do
		printf '%s%s' "$separator" "$argument" >>"$FAKE_STATE/op-calls"
		separator=$'\t'
	done
	printf '\n' >>"$FAKE_STATE/op-calls"
}

vault_id() {
	case "$1" in
	"Configured Vault") printf 'configured-vault-id' ;;
	"Target<>Vault") printf 'target-vault-id' ;;
	*) printf 'vault-id' ;;
	esac
}

canonical_vault() {
	case "$1" in
	configured-vault-id) printf 'Configured Vault' ;;
	target-vault-id) printf 'Target<>Vault' ;;
	*) printf '%s' "$1" ;;
	esac
}

same_vault() {
	[[ "$(canonical_vault "$1")" == "$(canonical_vault "$2")" ]]
}

item_json_list() {
	local requested_vault=$1 requested_category=$2
	local first=true
	local id category title vault public_key email scope username credential
	printf '['
	while IFS='|' read -r id category title vault public_key email scope username credential; do
		[[ -n "$id" ]] || continue
		if [[ -n "$requested_vault" ]] && ! same_vault "$vault" "$requested_vault"; then
			continue
		fi
		if [[ -n "$requested_category" && "$category" != "$requested_category" ]]; then
			continue
		fi
		if [[ "$first" == true ]]; then
			first=false
		else
			printf ','
		fi
		printf '{"id":"%s","title":"%s","category":"%s"}' "$id" "$title" "$category"
	done <"$FAKE_STATE/items"
	printf ']\n'
}

find_item() {
	local wanted=$1 requested_vault=$2
	local id category title vault public_key email scope username credential
	while IFS='|' read -r id category title vault public_key email scope username credential; do
		[[ -n "$id" ]] || continue
		if [[ "$id" != "$wanted" && "$title" != "$wanted" ]]; then
			continue
		fi
		if [[ -n "$requested_vault" ]] && ! same_vault "$vault" "$requested_vault"; then
			continue
		fi
		printf '%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
			"$id" "$category" "$title" "$vault" "$public_key" "$email" "$scope" \
			"$username" "$credential"
		return 0
	done <"$FAKE_STATE/items"
	return 1
}

log_call "$@"

case "${1:-} ${2:-}" in
"whoami ")
	printf '{"type":"SERVICE_ACCOUNT"}\n'
	;;
"account list")
	printf '[]\n'
	;;
"vault get")
	vault=${3:-}
	if [[ " $* " == *" --format json "* ]]; then
		printf '{"id":"%s","name":"%s"}\n' "$(vault_id "$vault")" "$vault"
	else
		printf '%s\n' "$vault"
	fi
	;;
"item list")
	requested_vault=""
	requested_category=""
	shift 2
	while (($# > 0)); do
		case "$1" in
		--vault)
			requested_vault=${2:-}
			shift 2
			;;
		--categories)
			requested_category=${2:-}
			shift 2
			;;
		*)
			shift
			;;
		esac
	done
	item_json_list "$requested_vault" "$requested_category"
	;;
"item get")
	wanted=${3:-}
	requested_vault=""
	field=""
	format=""
	shift 3
	while (($# > 0)); do
		case "$1" in
		--vault)
			requested_vault=${2:-}
			shift 2
			;;
		--fields)
			field=${2#label=}
			shift 2
			;;
		--format)
			format=${2:-}
			shift 2
			;;
		*)
			shift
			;;
		esac
	done
	if ! row=$(find_item "$wanted" "$requested_vault"); then
		printf "item not found: %s\n" "$wanted" >&2
		exit 1
	fi
	IFS='|' read -r id category title vault public_key email scope username credential <<<"$row"
	if [[ "$format" == json ]]; then
		printf '{"id":"%s","title":"%s"}\n' "$id" "$title"
	elif [[ -n "$field" ]]; then
		if [[ -n "${FAKE_OP_FAIL_FIELD:-}" && "$field" == "$FAKE_OP_FAIL_FIELD" ]]; then
			printf 'simulated field read failure: %s\n' "$field" >&2
			exit 1
		fi
		case "$field" in
		"public key") printf '%s\n' "$public_key" ;;
		email) printf '%s\n' "$email" ;;
		scope) printf '%s\n' "$scope" ;;
		username) printf '%s\n' "$username" ;;
		credential) printf '%s\n' "$credential" ;;
		*) exit 1 ;;
		esac
	else
		printf '%s\n' "$title"
	fi
	;;
"item create")
	category=""
	title=""
	vault=""
	email=""
	scope=""
	username=""
	credential=""
	shift 2
	while (($# > 0)); do
		case "$1" in
		--category)
			category=${2:-}
			shift 2
			;;
		--title)
			title=${2:-}
			shift 2
			;;
		--vault)
			vault=${2:-}
			shift 2
			;;
		email\[text\]=*)
			email=${1#email\[text\]=}
			shift
			;;
		scope\[text\]=*)
			scope=${1#scope\[text\]=}
			shift
			;;
		username\[text\]=*)
			username=${1#username\[text\]=}
			shift
			;;
		credential*=*)
			credential=${1#*=}
			shift
			;;
		*)
			shift
			;;
		esac
	done
	[[ "$category" == ssh ]] && category="SSH Key"
	line_count=$(wc -l <"$FAKE_STATE/items" | tr -d ' ')
	id="created-$((line_count + 1))"
	public_key=""
	if [[ "$category" == "SSH Key" ]]; then
		public_key="ssh-ed25519 TEST-$id $title"
	fi
	printf '%s|%s|%s|%s|%s|%s|%s|%s|%s\n' \
		"$id" "$category" "$title" "$vault" "$public_key" "$email" "$scope" \
		"$username" "$credential" \
		>>"$FAKE_STATE/items"
	printf '{"id":"%s"}\n' "$id"
	;;
"item edit")
	# No current test updates an existing item. Accepting the command keeps this
	# fake useful if implementation code performs a harmless idempotent edit.
	printf '{}\n'
	;;
"read "*)
	reference=""
	for argument in "$@"; do
		case "$argument" in
		op://*) reference=$argument ;;
		esac
	done
	[[ -n "$reference" ]] || exit 1
	without_scheme=${reference#op://}
	after_vault=${without_scheme#*/}
	id=${after_vault%%/*}
	field=${after_vault#*/}
	field=${field%%\?*}
	if ! row=$(find_item "$id" ""); then
		printf 'item not found: %s\n' "$id" >&2
		exit 1
	fi
	IFS='|' read -r id category title vault public_key email scope username credential <<<"$row"
	if [[ "$field" == credential ]]; then
		printf '%s' "$credential"
	else
		printf 'test-private-input-for-%s\n' "$id"
	fi
	;;
*)
	printf 'unsupported fake op call: %s\n' "$*" >&2
	exit 64
	;;
esac
FAKE_OP

cat >"$fake_bin/gh" <<'FAKE_GH'
#!/usr/bin/env bash
set -uo pipefail

separator=""
for argument in "$@"; do
	printf '%s%s' "$separator" "$argument" >>"$FAKE_STATE/gh-calls"
	separator=$'\t'
done
printf '\n' >>"$FAKE_STATE/gh-calls"

case "${GH_TOKEN:-}" in
fixture-default-correct)
	token_context=default-correct
	token_user=default-account
	;;
fixture-scoped-correct)
	token_context=scoped-correct
	token_user=Braden1996
	;;
fixture-scoped-wrong)
	token_context=scoped-wrong
	token_user=SomebodyElse
	;;
fixture-legacy)
	token_context=legacy
	token_user=LegacyAccount
	;;
"")
	token_context=ambient
	token_user=${FAKE_GH_USER:-test-user}
	;;
*)
	token_context=unknown
	token_user=UnknownTokenAccount
	;;
esac
printf '%s\n' "$token_context" >>"$FAKE_STATE/gh-contexts"

case "${1:-} ${2:-}" in
"auth status")
	printf "Token scopes: 'repo', 'admin:ssh_signing_key'\n" >&2
	;;
"auth refresh")
	;;
"api user" | "api /user")
	printf '%s\n' "$token_user"
	;;
"pr create")
	printf 'created pull request\n'
	;;
"ssh-key add")
	key_file=${3:-}
	key_type=""
	title=""
	shift 3
	while (($# > 0)); do
		case "$1" in
		--type)
			key_type=${2:-}
			shift 2
			;;
		--title)
			title=${2:-}
			shift 2
			;;
		*)
			shift
			;;
		esac
	done
	public_key=$(cat "$key_file")
	printf '%s|%s|%s\n' "$key_type" "$title" "$public_key" >>"$FAKE_STATE/gh-adds"
	if [[ -n "${FAKE_GH_FAIL_TYPE:-}" && "$key_type" == "$FAKE_GH_FAIL_TYPE" ]]; then
		exit 1
	fi
	;;
"api "*)
	# Provisioning inspects existing keys before adding them. Model gh's
	# --jq output as one raw public key per line.
	endpoint=""
	for argument in "$@"; do
		case "$argument" in
		user/keys | user/ssh_signing_keys)
			endpoint=$argument
			;;
		esac
	done
	case "$endpoint" in
	user/keys)
		awk -F'|' '$1 == "authentication" { print $3 }' "$FAKE_STATE/gh-adds"
		;;
	user/ssh_signing_keys)
		awk -F'|' '$1 == "signing" { print $3 }' "$FAKE_STATE/gh-adds"
		;;
	*)
		printf '[]\n'
		;;
	esac
	;;
*)
	printf 'unsupported fake gh call: %s\n' "$*" >&2
	exit 64
	;;
esac
FAKE_GH

cat >"$fake_bin/ssh-add" <<'FAKE_SSH_ADD'
#!/usr/bin/env bash
set -uo pipefail

case "${1:-}" in
-l | -L)
	# Exit 1 means the agent is reachable but currently holds no keys.
	exit 1
	;;
esac

arguments="$*"
payload=""
for argument in "$@"; do
	if [[ "$argument" == - ]]; then
		payload=$(cat)
		break
	fi
done
printf '%s|%s\n' "$arguments" "$payload" >>"$FAKE_STATE/ssh-adds"
FAKE_SSH_ADD

cat >"$fake_bin/security" <<'FAKE_SECURITY'
#!/usr/bin/env bash
set -uo pipefail
case "${1:-}" in
find-generic-password)
	if [[ " $* " == *" -w "* ]]; then
		printf 'test-service-token\n'
	fi
	;;
*)
	exit 64
	;;
esac
FAKE_SECURITY

cat >"$fake_bin/uname" <<'FAKE_UNAME'
#!/usr/bin/env bash
printf 'test-runner\n'
FAKE_UNAME

chmod +x "$fake_bin/op" "$fake_bin/gh" "$fake_bin/ssh-add" \
	"$fake_bin/security" "$fake_bin/uname"

# ---------------------------------------------------------------------------
# Render one desktop-backed and one service-account-backed helper.
# ---------------------------------------------------------------------------

render_helper() {
	local profile=$1 machine=$2 vault=$3 output=$4
	local default_github_user=${5-default-account}
	local home_dir="$temp_root/home-$profile"
	local config_file="$temp_root/config-$profile.toml"
	mkdir -p "$home_dir"
	cat >"$config_file" <<EOF
[data]
  machineType = "$profile"
  machineName = "$machine"
  gitName = "Dotfiles Test"
  defaultEmail = "default@example.com"
  defaultGitHubUser = "$default_github_user"
  opVault = "$vault"
  opTokenKeychainService = "dotfiles-test-token"
EOF
	HOME="$home_dir" \
		"$chezmoi_bin" execute-template \
		--config "$config_file" \
		--destination "$home_dir" \
		--no-tty \
		--source "$repo_root" \
		--file "$repo_root/dot_local/libexec/braden-dots/executable_identity.tmpl" >"$output"
	chmod +x "$output"
}

personal_helper="$temp_root/dotfiles-keys-personal"
work_helper="$temp_root/dotfiles-keys-work"
unsafe_machine_helper="$temp_root/dotfiles-keys-unsafe"
missing_identity_helper="$temp_root/dotfiles-keys-missing-identity"
render_helper personal ci-personal "Configured Vault" "$personal_helper"
render_helper work ci-work "Target<>Vault" "$work_helper"
render_helper personal "ci work" "Configured Vault" "$unsafe_machine_helper"
render_helper personal ci-missing "Configured Vault" "$missing_identity_helper" ""

run_helper() {
	local helper=$1
	shift
	PATH="$fake_bin:$PATH" HOME="$temp_root/home-${helper##*-}" "$helper" "$@"
}

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------

test_default_provision() {
	new_case default-provision
	export FAKE_GH_USER=work-account
	run_helper "$personal_helper" provision target-machine \
		--vault "Target<>Vault" --github-user work-account >/dev/null

	assert_eq 1 "$(item_count "GitHub Machine Auth (target-machine)" "Target<>Vault")" \
		"default provision should create one unsuffixed auth item"
	assert_eq 1 "$(item_count "GitHub Machine Sign (target-machine)" "Target<>Vault")" \
		"default provision should create one unsuffixed signing item"
	assert_eq 0 "$(item_count "GitHub Machine Auth (target-machine personal)" "Target<>Vault")" \
		"default provision must not create identity-suffixed items"
	assert_eq 2 "$(wc -l <"$FAKE_STATE/gh-adds" | tr -d ' ')" \
		"default provision should publish both public keys"
	assert_contains "$FAKE_STATE/gh-adds" \
		"authentication|GitHub Machine Auth (target-machine)" \
		"default provision should publish the authentication key"
	assert_contains "$FAKE_STATE/gh-adds" \
		"signing|GitHub Machine Sign (target-machine)" \
		"default provision should publish the signing key"
}

test_identity_provision() {
	new_case identity-provision
	export FAKE_GH_USER=personal-account
	run_helper "$personal_helper" provision target-machine \
		--identity personal --vault "Target<>Vault" \
		--github-user personal-account >/dev/null

	assert_eq 1 "$(item_count "GitHub Machine Auth (target-machine personal)" "Target<>Vault")" \
		"identity provision should create one suffixed auth item"
	assert_eq 1 "$(item_count "GitHub Machine Sign (target-machine personal)" "Target<>Vault")" \
		"identity provision should create one suffixed signing item"
	assert_eq 0 "$(item_count "GitHub Machine Auth (target-machine)" "Target<>Vault")" \
		"identity provision must not create the default pair"
}

test_legacy_identity_provision() {
	new_case legacy-provision
	export FAKE_GH_USER=personal-account
	run_helper "$personal_helper" provision target-machine personal "Target<>Vault" >/dev/null

	assert_eq 1 "$(item_count "GitHub Machine Auth (target-machine personal)" "Target<>Vault")" \
		"legacy provision syntax should still create a suffixed auth item"
	assert_eq 1 "$(item_count "GitHub Machine Sign (target-machine personal)" "Target<>Vault")" \
		"legacy provision syntax should still create a suffixed signing item"
}

test_identity_add_target_vault() {
	new_case identity-add
	run_helper "$personal_helper" identity-add personal personal@example.com \
		'Braden1996/**' --vault "Target<>Vault" >/dev/null

	assert_eq 1 "$(item_count "Git Identity (personal)" "Target<>Vault")" \
		"identity-add should create the item in the requested vault"
	assert_contains "$FAKE_STATE/items" \
		"|Git Identity (personal)|Target<>Vault||personal@example.com|Braden1996/**" \
		"identity-add should store text email and scope fields"
}

test_github_user_mismatch_is_read_only() {
	new_case user-mismatch
	export FAKE_GH_USER=unexpected-account
	if run_helper "$personal_helper" provision target-machine \
		--vault "Target<>Vault" --github-user expected-account >/dev/null 2>&1; then
		fail "GitHub user mismatch should fail"
	fi

	assert_eq 0 "$(wc -l <"$FAKE_STATE/items" | tr -d ' ')" \
		"GitHub user mismatch must not create vault items"
	assert_eq 0 "$(wc -l <"$FAKE_STATE/gh-adds" | tr -d ' ')" \
		"GitHub user mismatch must not publish keys"
}

test_help_and_empty_options_are_read_only() {
	new_case help-read-only
	export FAKE_GH_USER=work-account

	run_helper "$personal_helper" provision --help >/dev/null
	run_helper "$personal_helper" identity-add --help >/dev/null
	if run_helper "$personal_helper" provision target-machine \
		--identity '' --vault "Target<>Vault" >/dev/null 2>&1; then
		fail "an explicitly empty identity must fail"
	fi
	if run_helper "$personal_helper" provision target-machine \
		--vault "Target<>Vault" --github-user '' >/dev/null 2>&1; then
		fail "an explicitly empty GitHub user must fail"
	fi
	if run_helper "$personal_helper" identity-add unsafe '*@example.com' \
		'Braden1996/**' --vault "Target<>Vault" >/dev/null 2>&1; then
		fail "an allowed-signers email pattern must not be accepted as an identity"
	fi

	assert_eq 0 "$(wc -l <"$FAKE_STATE/items" | tr -d ' ')" \
		"help and invalid option/principal values must not create vault items"
	assert_eq 0 "$(wc -l <"$FAKE_STATE/gh-adds" | tr -d ' ')" \
		"help and invalid empty options must not publish keys"
}

test_unsafe_configured_machine_is_read_only() {
	new_case unsafe-machine
	if PATH="$fake_bin:$PATH" HOME="$temp_root/home-personal" \
		"$unsafe_machine_helper" generate >/dev/null 2>&1; then
		fail "generate should reject an unsafe configured machine name"
	fi
	assert_eq 0 "$(wc -l <"$FAKE_STATE/items" | tr -d ' ')" \
		"unsafe configured machine name must not create vault items"
}

test_work_backend_refuses_writes() {
	new_case work-refuses-writes
	export FAKE_GH_USER=work-account
	if run_helper "$work_helper" provision another-machine \
		--vault "Target<>Vault" --github-user work-account >/dev/null 2>&1; then
		fail "service-account provision should fail"
	fi

	assert_eq 0 "$(wc -l <"$FAKE_STATE/items" | tr -d ' ')" \
		"service-account provision must not create vault items"
	assert_eq 0 "$(wc -l <"$FAKE_STATE/gh-adds" | tr -d ' ')" \
		"service-account provision must not publish keys"

	if run_helper "$work_helper" identity-add personal personal@example.com \
		'Braden1996/**' --vault "Target<>Vault" >/dev/null 2>&1; then
		fail "service-account identity-add should fail"
	fi
	if run_helper "$work_helper" publish >/dev/null 2>&1; then
		fail "service-account publish should fail"
	fi
	assert_eq 0 "$(wc -l <"$FAKE_STATE/items" | tr -d ' ')" \
		"service-account identity-add must not create vault items"
	assert_eq 0 "$(wc -l <"$FAKE_STATE/gh-adds" | tr -d ' ')" \
		"service-account helper must not publish GitHub keys"
}

test_gh_wrapper_missing_scoped_token() {
	new_case gh-missing-token
	# Even an ambient session for the requested account must not be used.
	export FAKE_GH_USER=Braden1996
	if run_helper "$work_helper" gh personal -- pr create --title test \
		>/dev/null 2>&1; then
		fail "gh wrapper should fail when its exact scoped token item is missing"
	fi

	assert_contains "$FAKE_STATE/op-calls" \
		$'item\tget\tGitHub Machine PAT (ci-work personal)' \
		"gh wrapper should look up the exact machine-and-identity token title"
	assert_eq 0 "$(wc -l <"$FAKE_STATE/gh-calls" | tr -d ' ')" \
		"missing scoped token must not fall back to ambient gh authentication"
	assert_tokens_not_logged
}

test_desktop_backend_clears_non_desktop_auth() {
	new_case desktop-auth-boundary
	seed_item scoped-token "API Credential" \
		"GitHub Machine PAT (ci-personal personal)" "Configured Vault" \
		"" "" "" "Braden1996" "fixture-scoped-correct"
	export FAKE_EXPECT_DESKTOP_AUTH_ONLY=1

	local raw_token
	raw_token="$(
		OP_SERVICE_ACCOUNT_TOKEN=ambient-service-token \
			OP_CONNECT_HOST=https://connect.invalid \
			OP_CONNECT_TOKEN=ambient-connect-token \
			run_helper "$personal_helper" token personal
	)"
	unset FAKE_EXPECT_DESKTOP_AUTH_ONLY
	assert_eq fixture-scoped-correct "$raw_token" \
		"desktop backend should ignore ambient service-account and Connect auth"
}

test_gh_wrapper_empty_token() {
	new_case gh-empty-token
	seed_item scoped-token "API Credential" \
		"GitHub Machine PAT (ci-work personal)" "Target<>Vault" \
		"" "" "" "Braden1996" ""
	if run_helper "$work_helper" gh personal -- pr create --title test \
		>/dev/null 2>&1; then
		fail "gh wrapper should reject an empty scoped credential"
	fi

	assert_eq 0 "$(wc -l <"$FAKE_STATE/gh-calls" | tr -d ' ')" \
		"empty token must fail before invoking gh"
	assert_tokens_not_logged
}

test_gh_wrapper_missing_username() {
	new_case gh-missing-username
	seed_item scoped-token "API Credential" \
		"GitHub Machine PAT (ci-work personal)" "Target<>Vault" \
		"" "" "" "" "fixture-scoped-correct"
	if run_helper "$work_helper" gh personal -- pr create --title test \
		>/dev/null 2>&1; then
		fail "gh wrapper should reject a token item without a username"
	fi

	assert_eq 0 "$(wc -l <"$FAKE_STATE/gh-calls" | tr -d ' ')" \
		"missing token username must fail before invoking gh"
	assert_tokens_not_logged
}

test_gh_wrapper_wrong_token_account() {
	new_case gh-wrong-account
	# The ambient account is deliberately correct. The scoped token is not, and
	# must therefore fail rather than falling back to that ambient session.
	export FAKE_GH_USER=Braden1996
	seed_item scoped-token "API Credential" \
		"GitHub Machine PAT (ci-work personal)" "Target<>Vault" \
		"" "" "" "Braden1996" "fixture-scoped-wrong"
	if run_helper "$work_helper" gh personal -- pr create --title test \
		>/dev/null 2>&1; then
		fail "gh wrapper should reject a token authenticated as another account"
	fi

	assert_contains "$FAKE_STATE/gh-calls" $'api\tuser\t--jq\t.login' \
		"gh wrapper should verify the token account before the requested command"
	assert_not_contains "$FAKE_STATE/gh-calls" $'pr\tcreate' \
		"wrong-account token must not run the requested gh command"
	assert_not_contains "$FAKE_STATE/gh-contexts" ambient \
		"wrong-account token must not fall back to ambient authentication"
	assert_eq 1 "$(wc -l <"$FAKE_STATE/items" | tr -d ' ')" \
		"gh wrapper must not mutate the service-account vault"
	assert_tokens_not_logged
}

test_gh_wrapper_correct_scoped_token() {
	new_case gh-correct-token
	# Explicit ambient credentials must be overwritten, not merely ignored when
	# absent. The scoped credential is the only one either gh invocation sees.
	export GH_TOKEN=fixture-scoped-wrong
	export GITHUB_TOKEN=fixture-legacy
	seed_item scoped-token "API Credential" \
		"GitHub Machine PAT (ci-work personal)" "Target<>Vault" \
		"" "" "" "Braden1996" "fixture-scoped-correct"

	local raw_token
	raw_token="$(run_helper "$work_helper" token personal)"
	if [[ "$raw_token" != fixture-scoped-correct ]]; then
		fail "token personal should print only the exact scoped credential"
	fi
	run_helper "$work_helper" gh personal -- pr create --title test >/dev/null

	assert_contains "$FAKE_STATE/gh-calls" $'api\tuser\t--jq\t.login' \
		"gh wrapper should verify the scoped token account"
	assert_contains "$FAKE_STATE/gh-calls" $'pr\tcreate\t--title\ttest' \
		"gh wrapper should forward every argument after --"
	if grep -Fvx scoped-correct "$FAKE_STATE/gh-contexts" >/dev/null; then
		fail "every gh invocation should use the scoped credential"
	fi
	assert_eq 1 "$(wc -l <"$FAKE_STATE/items" | tr -d ' ')" \
		"successful service-account gh wrapper must remain vault-read-only"
	assert_not_contains "$FAKE_STATE/op-calls" $'item\tcreate' \
		"gh wrapper must never create vault items"
	assert_not_contains "$FAKE_STATE/op-calls" $'item\tedit' \
		"gh wrapper must never edit vault items"
	assert_tokens_not_logged
	unset raw_token
}

test_gh_wrapper_resolves_repository_account() {
	new_case gh-repo-default
	seed_item default-token "API Credential" \
		"GitHub Machine PAT (ci-work)" "Target<>Vault" \
		"" "" "" "default-account" "fixture-default-correct"

	local repo
	repo="$FAKE_STATE/repo"
	git init -q "$repo"
	# shellcheck disable=SC2088
	git -C "$repo" config user.signingkey "~/.ssh/id_github_sign.pub"
	git -C "$repo" remote add origin \
		git@github.com:Isembard-Mason/mason-os.git
	run_helper "$work_helper" gh --repo "$repo" -- pr create --title test \
		>/dev/null

	assert_contains "$FAKE_STATE/op-calls" \
		$'item\tget\tGitHub Machine PAT (ci-work)' \
		"default repository route should select the machine token"
	if grep -Fvx default-correct "$FAKE_STATE/gh-contexts" >/dev/null; then
		fail "the default repository route should use only the default token"
	fi
	assert_tokens_not_logged

	new_case gh-repo-scoped
	seed_item scoped-token "API Credential" \
		"GitHub Machine PAT (ci-work personal)" "Target<>Vault" \
		"" "" "" "Braden1996" "fixture-scoped-correct"
	repo="$FAKE_STATE/repo"
	git init -q "$repo"
	# shellcheck disable=SC2088
	git -C "$repo" config user.signingkey \
		"~/.ssh/id_github_sign_personal.pub"
	git -C "$repo" remote add origin \
		git@github-personal:Braden1996/dotfiles.git
	run_helper "$work_helper" gh --repo="$repo" -- pr create --title test \
		>/dev/null

	assert_contains "$FAKE_STATE/op-calls" \
		$'item\tget\tGitHub Machine PAT (ci-work personal)' \
		"scoped repository route should select its machine-and-identity token"
	if grep -Fvx scoped-correct "$FAKE_STATE/gh-contexts" >/dev/null; then
		fail "the scoped repository route should use only its scoped token"
	fi
	assert_tokens_not_logged
}

test_gh_wrapper_rejects_repository_route_mismatch() {
	new_case gh-repo-route-mismatch
	local repo
	repo="$FAKE_STATE/repo"
	git init -q "$repo"
	# shellcheck disable=SC2088
	git -C "$repo" config user.signingkey \
		"~/.ssh/id_github_sign_personal.pub"
	git -C "$repo" remote add origin \
		git@github.com:Braden1996/dotfiles.git

	if run_helper "$work_helper" gh --repo "$repo" -- pr create --title test \
		>/dev/null 2>&1; then
		fail "repository-aware gh should reject a mismatched SSH account route"
	fi
	assert_eq 0 "$(wc -l <"$FAKE_STATE/op-calls" | tr -d ' ')" \
		"route mismatch should fail before reading a token"
	assert_eq 0 "$(wc -l <"$FAKE_STATE/gh-calls" | tr -d ' ')" \
		"route mismatch should fail before invoking gh"
}

test_gh_wrapper_rejects_default_token_label_mismatch() {
	new_case gh-default-user-mismatch
	seed_item default-token "API Credential" \
		"GitHub Machine PAT (ci-work)" "Target<>Vault" \
		"" "" "" "SomebodyElse" "fixture-default-correct"

	local repo
	repo="$FAKE_STATE/repo"
	git init -q "$repo"
	# shellcheck disable=SC2088
	git -C "$repo" config user.signingkey "~/.ssh/id_github_sign.pub"
	git -C "$repo" remote add origin \
		git@github.com:Isembard-Mason/mason-os.git

	if run_helper "$work_helper" gh --repo "$repo" -- pr create --title test \
		>/dev/null 2>&1; then
		fail "default token label should match the configured github.com account"
	fi
	assert_eq 0 "$(wc -l <"$FAKE_STATE/gh-calls" | tr -d ' ')" \
		"default token label mismatch should fail before invoking gh"
	assert_tokens_not_logged
}

test_raw_token_legacy_and_no_scoped_fallback() {
	new_case token-legacy
	seed_item legacy-token "API Credential" "GitHub Machine PAT" \
		"Target<>Vault" "" "" "" "" "fixture-legacy"

	local raw_token
	raw_token="$(run_helper "$work_helper" token)"
	if [[ "$raw_token" != fixture-legacy ]]; then
		fail "token without an identity should retain the legacy item behavior"
	fi
	if run_helper "$work_helper" token personal >/dev/null 2>&1; then
		fail "token personal must not fall back to the legacy token item"
	fi
	export FAKE_GH_USER=Braden1996
	if run_helper "$work_helper" gh personal -- pr create --title test \
		>/dev/null 2>&1; then
		fail "gh personal must not fall back to the legacy or ambient token"
	fi

	assert_contains "$FAKE_STATE/op-calls" \
		$'item\tget\tGitHub Machine PAT (ci-work personal)' \
		"scoped token commands should use an exact item lookup"
	assert_eq 0 "$(wc -l <"$FAKE_STATE/gh-calls" | tr -d ' ')" \
		"missing scoped token must fail before gh even when legacy and ambient auth exist"
	assert_tokens_not_logged
	unset raw_token
}

test_end_to_end_cross_vault_workflow() {
	new_case end-to-end

	export FAKE_GH_USER=work-account
	run_helper "$personal_helper" provision ci-work \
		--vault "Target<>Vault" --github-user work-account >/dev/null

	export FAKE_GH_USER=personal-account
	run_helper "$personal_helper" identity-add personal personal@example.com \
		'Braden1996/**' --vault "Target<>Vault" >/dev/null
	run_helper "$personal_helper" provision ci-work \
		--identity personal --vault "Target<>Vault" \
		--github-user personal-account >/dev/null

	# A rerun must reuse both vault items and already-published GitHub keys.
	run_helper "$personal_helper" provision ci-work \
		--identity personal --vault "Target<>Vault" \
		--github-user personal-account >/dev/null
	assert_eq 1 "$(item_count "GitHub Machine Auth (ci-work personal)" "Target<>Vault")" \
		"rerunning identity provision must not duplicate the auth item"
	assert_eq 1 "$(item_count "GitHub Machine Sign (ci-work personal)" "Target<>Vault")" \
		"rerunning identity provision must not duplicate the signing item"
	assert_eq 4 "$(wc -l <"$FAKE_STATE/gh-adds" | tr -d ' ')" \
		"rerunning provision must not republish existing GitHub keys"

	run_helper "$work_helper" sync >/dev/null
	: >"$FAKE_STATE/ssh-adds"
	run_helper "$work_helper" load >/dev/null
	assert_eq 4 "$(wc -l <"$FAKE_STATE/ssh-adds" | tr -d ' ')" \
		"the complete trusted-machine workflow should load all four work keys"
	assert_contains "$temp_root/home-work/.ssh/config.d/10-personal.conf" \
		"Host github-personal" \
		"the complete workflow should create the personal host alias"
}

test_loads_default_and_identity_pairs() {
	new_case load-four
	local work_home status_output unload_output
	seed_item base-auth "SSH Key" "GitHub Machine Auth (ci-work)" \
		"Target<>Vault" "ssh-ed25519 TEST-base-auth base-auth"
	seed_item base-sign "SSH Key" "GitHub Machine Sign (ci-work)" \
		"Target<>Vault" "ssh-ed25519 TEST-base-sign base-sign"
	seed_item identity-personal "Secure Note" "Git Identity (personal)" \
		"Target<>Vault" "" "personal@example.com" "Braden1996/**"
	seed_item personal-auth "SSH Key" "GitHub Machine Auth (ci-work personal)" \
		"Target<>Vault" "ssh-ed25519 TEST-personal-auth personal-auth"
	seed_item personal-sign "SSH Key" "GitHub Machine Sign (ci-work personal)" \
		"Target<>Vault" "ssh-ed25519 TEST-personal-sign personal-sign"

	run_helper "$work_helper" sync >/dev/null
	work_home="$temp_root/home-work"
	assert_contains "$work_home/.ssh/config.d/10-personal.conf" \
		"Host github-personal" \
		"sync should create the personal GitHub host alias"
	assert_contains "$work_home/.config/git/identities/personal.gitconfig" \
		"signingkey = ~/.ssh/id_github_sign_personal.pub" \
		"the personal identity should select its own signing key"
	assert_contains "$work_home/.ssh/allowed_signers" \
		"default@example.com ssh-ed25519 TEST-base-sign base-sign" \
		"the default identity should trust the base signing key"
	assert_contains "$work_home/.ssh/allowed_signers" \
		"personal@example.com ssh-ed25519 TEST-personal-sign personal-sign" \
		"the personal identity should trust its account signing key"
	if grep -Fq "default@example.com ssh-ed25519 TEST-personal-sign" \
		"$work_home/.ssh/allowed_signers"; then
		fail "the personal signing key must not verify as the default identity"
	fi
	if grep -Fq "personal@example.com ssh-ed25519 TEST-base-sign" \
		"$work_home/.ssh/allowed_signers"; then
		fail "the base signing key must not verify as the personal identity"
	fi

	: >"$FAKE_STATE/ssh-adds"
	run_helper "$work_helper" load >/dev/null

	assert_eq 4 "$(wc -l <"$FAKE_STATE/ssh-adds" | tr -d ' ')" \
		"work load should add the default and identity keypairs"
	for id in base-auth base-sign personal-auth personal-sign; do
		assert_contains "$FAKE_STATE/ssh-adds" "test-private-input-for-$id" \
			"work load should stream $id into the agent"
	done
	if awk -F'|' '$1 != "-t 9h -" { exit 1 }' "$FAKE_STATE/ssh-adds"; then
		:
	else
		fail "every work key should be loaded with the 9h lifetime"
	fi

	status_output="$FAKE_STATE/status-output"
	run_helper "$work_helper" status >"$status_output"
	assert_contains "$status_output" "'personal' authentication key" \
		"status should report the identity-specific authentication key"
	assert_contains "$status_output" "'personal' signing key" \
		"status should report the identity-specific signing key"

	# Leave only account-specific public files. `unload` should still recognize
	# managed keys even when the default pair is unavailable.
	rm -f -- "$work_home/.ssh/id_github_auth.pub" "$work_home/.ssh/id_github_sign.pub"
	unload_output="$FAKE_STATE/unload-output"
	run_helper "$work_helper" unload >"$unload_output"
	assert_contains "$unload_output" "no managed keys were loaded" \
		"unload should enumerate identity-specific public key files"
}

test_partial_pair_preserves_routing() {
	new_case partial-pair
	local alias_file
	seed_item base-auth "SSH Key" "GitHub Machine Auth (ci-work)" \
		"Target<>Vault" "ssh-ed25519 TEST-base-auth base-auth"
	seed_item base-sign "SSH Key" "GitHub Machine Sign (ci-work)" \
		"Target<>Vault" "ssh-ed25519 TEST-base-sign base-sign"
	seed_item identity-personal "Secure Note" "Git Identity (personal)" \
		"Target<>Vault" "" "personal@example.com" "Braden1996/**"
	seed_item personal-auth "SSH Key" "GitHub Machine Auth (ci-work personal)" \
		"Target<>Vault" "ssh-ed25519 TEST-personal-auth personal-auth"
	seed_item personal-sign "SSH Key" "GitHub Machine Sign (ci-work personal)" \
		"Target<>Vault" "ssh-ed25519 TEST-personal-sign personal-sign"

	run_helper "$work_helper" sync >/dev/null
	alias_file="$temp_root/home-work/.ssh/config.d/10-personal.conf"
	[[ -f "$alias_file" ]] || fail "complete account pair should create routing"

	awk -F'|' '$1 != "personal-sign"' "$FAKE_STATE/items" >"$FAKE_STATE/items.next"
	mv -- "$FAKE_STATE/items.next" "$FAKE_STATE/items"
	if run_helper "$work_helper" sync >/dev/null 2>&1; then
		fail "sync should reject an incomplete account keypair"
	fi
	[[ -f "$alias_file" ]] ||
		fail "failed sync must preserve the last complete account routing"
}

test_duplicate_and_field_failure_preserve_routing() {
	new_case invalid-snapshot
	local alias_file
	seed_item base-auth "SSH Key" "GitHub Machine Auth (ci-work)" \
		"Target<>Vault" "ssh-ed25519 TEST-base-auth base-auth"
	seed_item base-sign "SSH Key" "GitHub Machine Sign (ci-work)" \
		"Target<>Vault" "ssh-ed25519 TEST-base-sign base-sign"
	seed_item identity-personal "Secure Note" "Git Identity (personal)" \
		"Target<>Vault" "" "personal@example.com" "Braden1996/**"
	seed_item personal-auth "SSH Key" "GitHub Machine Auth (ci-work personal)" \
		"Target<>Vault" "ssh-ed25519 TEST-personal-auth personal-auth"
	seed_item personal-sign "SSH Key" "GitHub Machine Sign (ci-work personal)" \
		"Target<>Vault" "ssh-ed25519 TEST-personal-sign personal-sign"
	run_helper "$work_helper" sync >/dev/null
	alias_file="$temp_root/home-work/.ssh/config.d/10-personal.conf"

	seed_item duplicate-auth "SSH Key" "GitHub Machine Auth (ci-work personal)" \
		"Target<>Vault" "ssh-ed25519 TEST-duplicate-auth duplicate-auth"
	if run_helper "$work_helper" sync >/dev/null 2>&1; then
		fail "sync should reject duplicate key titles"
	fi
	[[ -f "$alias_file" ]] ||
		fail "duplicate key rejection must preserve the last complete routing"
	awk -F'|' '$1 != "duplicate-auth"' "$FAKE_STATE/items" >"$FAKE_STATE/items.next"
	mv -- "$FAKE_STATE/items.next" "$FAKE_STATE/items"

	export FAKE_OP_FAIL_FIELD=scope
	if run_helper "$work_helper" sync >/dev/null 2>&1; then
		fail "sync should fail when an identity field cannot be read"
	fi
	[[ -f "$alias_file" ]] ||
		fail "identity read failure must preserve the last complete routing"
}

test_load_rejects_duplicate_account_pair() {
	new_case duplicate-load
	seed_item base-auth "SSH Key" "GitHub Machine Auth (ci-work)" \
		"Target<>Vault" "ssh-ed25519 TEST-base-auth base-auth"
	seed_item base-sign "SSH Key" "GitHub Machine Sign (ci-work)" \
		"Target<>Vault" "ssh-ed25519 TEST-base-sign base-sign"
	seed_item identity-personal "Secure Note" "Git Identity (personal)" \
		"Target<>Vault" "" "personal@example.com" "Braden1996/**"
	seed_item personal-auth-a "SSH Key" "GitHub Machine Auth (ci-work personal)" \
		"Target<>Vault" "ssh-ed25519 TEST-personal-auth-a personal-auth-a"
	seed_item personal-auth-b "SSH Key" "GitHub Machine Auth (ci-work personal)" \
		"Target<>Vault" "ssh-ed25519 TEST-personal-auth-b personal-auth-b"
	seed_item personal-sign-a "SSH Key" "GitHub Machine Sign (ci-work personal)" \
		"Target<>Vault" "ssh-ed25519 TEST-personal-sign-a personal-sign-a"
	seed_item personal-sign-b "SSH Key" "GitHub Machine Sign (ci-work personal)" \
		"Target<>Vault" "ssh-ed25519 TEST-personal-sign-b personal-sign-b"

	if run_helper "$work_helper" load >/dev/null 2>&1; then
		fail "load should fail when account key titles are duplicated"
	fi
	assert_eq 2 "$(wc -l <"$FAKE_STATE/ssh-adds" | tr -d ' ')" \
		"duplicate account keys must not be selected arbitrarily"
}

test_publish_failure_is_nonzero() {
	new_case publish-failure
	export FAKE_GH_USER=work-account
	export FAKE_GH_FAIL_TYPE=signing
	if run_helper "$personal_helper" provision target-machine \
		--vault "Target<>Vault" --github-user work-account >/dev/null 2>&1; then
		fail "a signing-key publish failure must make provision fail"
	fi
	assert_eq 1 "$(wc -l <"$FAKE_STATE/gh-adds" | tr -d ' ')" \
		"provision should stop after the signing key fails"
	assert_contains "$FAKE_STATE/gh-adds" \
		"signing|GitHub Machine Sign (target-machine)" \
		"provision should publish signing first to avoid an auth-only setup"
}

test_status_json_and_expired_key_recovery() {
	new_case structured-status
	local work_home status_json repo
	seed_item base-auth "SSH Key" "GitHub Machine Auth (ci-work)" \
		"Target<>Vault" "ssh-ed25519 TEST-base-auth base-auth"
	seed_item base-sign "SSH Key" "GitHub Machine Sign (ci-work)" \
		"Target<>Vault" "ssh-ed25519 TEST-base-sign base-sign"
	run_helper "$work_helper" sync >/dev/null
	work_home="$temp_root/home-work"

	status_json="$FAKE_STATE/status.json"
	run_helper "$work_helper" status --json >"$status_json"
	jq -e '
		.schemaVersion == 1
		and .machine.profile == "work"
		and .credentials.backend == "service-account"
		and .credentials.defaultGitHubUser == "default-account"
		and .credentials.workKeyLifetime == "9h"
		and (.issues | index("agent_keys_missing"))
	' "$status_json" >/dev/null ||
		fail "identity status JSON should be versioned and code expired keys"
	if grep -Fq 'TEST-base-' "$status_json"; then
		fail "identity status JSON must not include public-key bodies"
	fi

	: >"$FAKE_STATE/ssh-adds"
	if run_helper "$work_helper" ensure >/dev/null 2>&1; then
		fail "the stateless fake agent should remain missing after reload"
	fi
	assert_eq 2 "$(wc -l <"$FAKE_STATE/ssh-adds" | tr -d ' ')" \
		"ensure should reload both expired work keys"
	if awk -F'|' '$1 != "-t 9h -" { exit 1 }' "$FAKE_STATE/ssh-adds"; then
		:
	else
		fail "ensure should preserve the nine-hour work-key expiry"
	fi

	repo="$FAKE_STATE/repo"
	git init -q "$repo"
	git -C "$repo" config user.name "Scoped Author"
	git -C "$repo" config user.email "scoped@example.com"
	# Git expands this configured path; the shell must preserve the literal tilde.
	# shellcheck disable=SC2088
	git -C "$repo" config user.signingkey "~/.ssh/id_github_sign.pub"
	git -C "$repo" remote add origin https://github.com/Braden1996/dotfiles.git
	run_helper "$work_helper" status --repo "$repo" --json >"$status_json"
	jq -e '
		.effectiveRepository.author.email == "scoped@example.com"
		and .effectiveRepository.sshHost == null
		and (.issues | index("remote_identity_mismatch"))
	' "$status_json" >/dev/null ||
		fail "repo-aware identity JSON should diagnose HTTPS route mismatch"

	new_case missing-default-identity
	status_json="$FAKE_STATE/missing.json"
	PATH="$fake_bin:$PATH" HOME="$temp_root/home-personal" \
		"$missing_identity_helper" status --json >"$status_json"
	jq -e '.issues | index("default_github_user_missing")' \
		"$status_json" >/dev/null ||
		fail "missing default GitHub identity should have a stable issue code"
}

run_test() {
	local name=$1
	shift
	printf 'test: %s ... ' "$name"
	"$@"
	printf 'ok\n'
}

run_test "default provision" test_default_provision
run_test "identity provision" test_identity_provision
run_test "legacy identity provision syntax" test_legacy_identity_provision
run_test "identity-add target vault" test_identity_add_target_vault
run_test "GitHub user mismatch is read-only" test_github_user_mismatch_is_read_only
run_test "help and empty options are read-only" test_help_and_empty_options_are_read_only
run_test "unsafe configured machine is read-only" test_unsafe_configured_machine_is_read_only
run_test "service-account writes are refused" test_work_backend_refuses_writes
run_test "desktop auth boundary is explicit" test_desktop_backend_clears_non_desktop_auth
run_test "gh wrapper rejects missing scoped token" test_gh_wrapper_missing_scoped_token
run_test "gh wrapper rejects empty token" test_gh_wrapper_empty_token
run_test "gh wrapper rejects missing username" test_gh_wrapper_missing_username
run_test "gh wrapper rejects wrong token account" test_gh_wrapper_wrong_token_account
run_test "gh wrapper uses correct scoped token" test_gh_wrapper_correct_scoped_token
run_test "gh wrapper resolves repository account" test_gh_wrapper_resolves_repository_account
run_test "gh wrapper rejects repository route mismatch" test_gh_wrapper_rejects_repository_route_mismatch
run_test "gh wrapper rejects default token label mismatch" test_gh_wrapper_rejects_default_token_label_mismatch
run_test "raw token legacy behavior is isolated" test_raw_token_legacy_and_no_scoped_fallback

#!/usr/bin/env bash

# Keep README.md's compact software inventory aligned with the real profiles.
# Markdown code spans deliberately use literal backticks.
# shellcheck disable=SC2016

set -euo pipefail

usage() {
	cat >&2 <<'USAGE'
usage: generate-docs [--check]

  (no flags)  Rewrite the generated software block in README.md.
  --check     Fail if README.md does not match its sources of truth.
USAGE
	exit 2
}

check_only=false
case "${1:-}" in
"") ;;
--check) check_only=true ;;
*) usage ;;
esac
[[ $# -le 1 ]] || usage

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
readme="$repo_root/README.md"
chezmoi_bin=${CHEZMOI_BIN:-chezmoi}
command -v "$chezmoi_bin" >/dev/null 2>&1 || {
	echo "chezmoi is required" >&2
	exit 1
}

temp_root=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-docs.XXXXXX")
trap 'rm -rf "$temp_root"' EXIT INT TERM

render_brewfile() {
	local profile=$1
	local config_file="$temp_root/config-$profile.toml"

	mkdir -p "$temp_root/home"
	cat >"$config_file" <<EOF
[data]
  machineType = "$profile"
  machineName = "docs"
  gitName = "Docs"
  defaultEmail = "docs@example.com"
  opVault = "Example Vault"
EOF

	HOME="$temp_root/home" \
		"$chezmoi_bin" execute-template \
		--config "$config_file" \
		--destination "$temp_root/home" \
		--no-tty \
		--source "$repo_root" \
		--file dot_config/homebrew/Brewfile.tmpl
}

brew_names() {
	local kind=$1 file=$2
	awk -v kind="$kind" '
		$1 == kind {
			match($0, /"[^"]+"/)
			print substr($0, RSTART + 1, RLENGTH - 2)
		}
	' "$file" | sort -u
}

code_list() {
	local first=true value
	if [[ ! -s "$1" ]]; then
		printf '—'
		return
	fi
	while IFS= read -r value; do
		[[ -n "$value" ]] || continue
		$first || printf ', '
		printf '`%s`' "$value"
		first=false
	done <"$1"
}

emit_profile_row() {
	local label=$1 file=$2
	printf '| %s | ' "$label"
	code_list "$file"
	printf ' |\n'
}

personal_brew="$temp_root/Brewfile-personal"
work_brew="$temp_root/Brewfile-work"
render_brewfile personal >"$personal_brew"
render_brewfile work >"$work_brew"

for kind in brew cask; do
	brew_names "$kind" "$personal_brew" >"$temp_root/$kind-personal"
	brew_names "$kind" "$work_brew" >"$temp_root/$kind-work"
	comm -12 "$temp_root/$kind-personal" "$temp_root/$kind-work" >"$temp_root/$kind-shared"
	comm -23 "$temp_root/$kind-personal" "$temp_root/$kind-work" >>"$temp_root/personal-only"
	comm -13 "$temp_root/$kind-personal" "$temp_root/$kind-work" >>"$temp_root/work-only"
done
sort -u -o "$temp_root/personal-only" "$temp_root/personal-only"
sort -u -o "$temp_root/work-only" "$temp_root/work-only"

awk '
	/^\[tools\]/ { in_tools = 1; next }
	/^\[/ { in_tools = 0 }
	in_tools && /=/ {
		gsub(/[[:space:]]|"/, "")
		split($0, pair, "=")
		print pair[1] " " pair[2]
	}
' "$repo_root/dot_config/mise/config.toml" >"$temp_root/mise-tools"

cursor_count=$(grep -cvE '^[[:space:]]*(#|$)' "$repo_root/dot_config/cursor/extensions.txt")
zsh_count=$(grep -cvE '^[[:space:]]*(#|$)' "$repo_root/dot_zsh_plugins.txt")
if command -v jq >/dev/null 2>&1; then
	nvim_count=$(jq 'keys | length' "$repo_root/dot_config/nvim/lazy-lock.json")
else
	nvim_count=$(grep -cE '^[[:space:]]*"' "$repo_root/dot_config/nvim/lazy-lock.json")
fi
tmux_count=$(grep -cE '^\["\.tmux/plugins/' "$repo_root/.chezmoiexternal.toml")

body="$temp_root/software"
{
	printf '| Scope | Installed |\n'
	printf '| --- | --- |\n'
	emit_profile_row 'Homebrew formulae · both' "$temp_root/brew-shared"
	emit_profile_row 'Homebrew casks · both' "$temp_root/cask-shared"
	emit_profile_row 'Homebrew · personal only' "$temp_root/personal-only"
	emit_profile_row 'Homebrew · work only' "$temp_root/work-only"
	emit_profile_row 'mise runtimes · both' "$temp_root/mise-tools"
	printf '\n'
	printf 'Extensions/plugins: [Cursor](dot_config/cursor/extensions.txt) %s · ' "$cursor_count"
	printf '[Zsh](dot_zsh_plugins.txt) %s · ' "$zsh_count"
	printf '[Neovim](dot_config/nvim/lazy-lock.json) %s · tmux %s\n' "$nvim_count" "$tmux_count"
} >"$body"

if ! grep -Fq '<!-- generated:software -->' "$readme"; then
	echo "README.md is missing the generated software marker" >&2
	exit 1
fi

rendered="$temp_root/README.md"
awk -v body="$body" '
	$0 == "<!-- generated:software -->" {
		print
		print "<!-- Do not edit by hand: run `mise run docs`. -->"
		while ((getline line < body) > 0) print line
		close(body)
		skipping = 1
		next
	}
	$0 == "<!-- /generated:software -->" { skipping = 0 }
	!skipping { print }
' "$readme" >"$rendered"

if $check_only; then
	if ! diff -u "$readme" "$rendered"; then
		echo "README.md is out of date; run: mise run docs" >&2
		exit 1
	fi
	echo "README.md software inventory matches its sources of truth."
else
	cp "$rendered" "$readme"
	echo "Regenerated README.md software inventory."
fi

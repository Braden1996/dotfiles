#!/usr/bin/env bash

# Exercise `braden-dots secret` without contacting 1Password or the Keychain.

set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
chezmoi_bin=${CHEZMOI_BIN:-chezmoi}
command -v "$chezmoi_bin" >/dev/null 2>&1 || {
	echo "chezmoi is required" >&2
	exit 1
}
command -v jq >/dev/null 2>&1 || {
	echo "jq is required" >&2
	exit 1
}

temp_root=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-secrets-test.XXXXXX")
trap 'rm -rf "$temp_root"' EXIT INT TERM

fake_bin="$temp_root/bin"
fake_state="$temp_root/state"
mkdir -p "$fake_bin" "$fake_state"
export FAKE_STATE="$fake_state"

fail() {
	printf 'FAIL: %s\n' "$*" >&2
	exit 1
}

assert_contains() {
	local file=$1 text=$2 message=$3
	grep -Fq -- "$text" "$file" || {
		printf 'FAIL: %s\n  missing: %s\n' "$message" "$text" >&2
		exit 1
	}
}

assert_not_contains() {
	local file=$1 text=$2 message=$3
	if grep -Fq -- "$text" "$file"; then
		printf 'FAIL: %s\n  unexpected: %s\n' "$message" "$text" >&2
		exit 1
	fi
}

reset_state() {
	: >"$fake_state/items"
	: >"$fake_state/last-edit.json"
	: >"$fake_state/op-calls"
	: >"$fake_state/security-calls"
}

cat >"$fake_bin/op" <<'FAKE_OP'
#!/usr/bin/env bash
set -euo pipefail

if [[ "${FAKE_EXPECT_DESKTOP_AUTH_ONLY:-0}" == 1 ]] &&
	[[ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}${OP_CONNECT_HOST:-}${OP_CONNECT_TOKEN:-}" ]]; then
	printf 'ambient non-desktop authentication reached op\n' >&2
	exit 97
fi
if [[ "${FAKE_REQUIRE_WORK_SERVICE_AUTH:-0}" == 1 ]] &&
	[[ "${OP_SERVICE_ACCOUNT_TOKEN:-}" != fixture-service-token ||
		-n "${OP_CONNECT_HOST:-}${OP_CONNECT_TOKEN:-}" ]]; then
	printf 'work read did not use only the configured service-account token\n' >&2
	exit 98
fi

separator=""
for argument in "$@"; do
	printf '%s%s' "$separator" "$argument" >>"$FAKE_STATE/op-calls"
	separator=$'\t'
done
printf '\n' >>"$FAKE_STATE/op-calls"

vault_id() {
	case "$1" in
	"Personal Vault") printf 'personal-vault-id' ;;
	"Work Vault") printf 'work-vault-id' ;;
	"Other Vault") printf 'other-vault-id' ;;
	*) printf '%s' "$1" ;;
	esac
}

find_item() {
	local wanted=$1 vault=$2
	local id title item_vault field value
	while IFS='|' read -r id title item_vault field value; do
		[[ -n "$id" ]] || continue
		if [[ "$wanted" == "$id" || "$wanted" == "$title" ]] &&
			[[ "$vault" == "$item_vault" ]]; then
			printf '%s|%s|%s|%s|%s\n' "$id" "$title" "$item_vault" "$field" "$value"
			return 0
		fi
	done <"$FAKE_STATE/items"
	return 1
}

case "${1:-} ${2:-}" in
"vault get")
	printf '{"id":"%s"}\n' "$(vault_id "${3:-}")"
	;;
"item get")
	wanted=${3:-}
	vault=""
	shift 3
	while (($# > 0)); do
		case "$1" in
		--vault)
			vault=${2:-}
			shift 2
			;;
		*)
			shift
			;;
		esac
	done
	if ! row=$(find_item "$wanted" "$vault"); then
		printf 'item not found: %s\n' "$wanted" >&2
		exit 1
	fi
	IFS='|' read -r id title item_vault field value <<<"$row"
	jq -n \
		--arg id "$id" \
		--arg title "$title" \
		--arg category "${FAKE_ITEM_CATEGORY:-API_CREDENTIAL}" \
		--arg field "$field" \
		--arg field_label "${FAKE_FIELD_LABEL:-$field}" \
		'{
			id: $id,
			title: $title,
			category: $category,
			tags: ["existing-tag"],
			notesPlain: "keep this note",
			urls: [{href: "https://example.test"}],
			fields: [
				{id: $field, label: $field_label, type: "CONCEALED"},
				{id: "unrelated", label: "unrelated", type: "STRING", value: "keep-me"}
			]
		}'
	;;
"item create")
	vault=""
	shift 2
	while (($# > 0)); do
		case "$1" in
		--vault)
			vault=${2:-}
			shift 2
			;;
		*)
			shift
			;;
		esac
	done
	template=$(cat)
	title=$(jq -r '.title' <<<"$template")
	field=$(jq -r '.fields[] | select(.type == "CONCEALED") | .id' <<<"$template")
	value=$(jq -r --arg field "$field" \
		'.fields[] | select(.id == $field) | .value' <<<"$template")
	printf 'item-1|%s|%s|%s|%s\n' "$title" "$vault" "$field" "$value" \
		>>"$FAKE_STATE/items"
	printf '{"id":"item-1"}\n'
	;;
"item edit")
	wanted=${3:-}
	vault=""
	shift 3
	while (($# > 0)); do
		case "$1" in
		--vault)
			vault=${2:-}
			shift 2
			;;
		*)
			shift
			;;
		esac
	done
	template=$(cat)
	printf '%s\n' "$template" >"$FAKE_STATE/last-edit.json"
	title=$(jq -r '.title' <<<"$template")
	field=$(jq -r '.fields[] | select(.type == "CONCEALED") | .id' <<<"$template")
	value=$(jq -r --arg field "$field" \
		'.fields[] | select(.id == $field) | .value' <<<"$template")
	next="$FAKE_STATE/items.next"
	: >"$next"
	while IFS='|' read -r id old_title item_vault old_field old_value; do
		[[ -n "$id" ]] || continue
		if [[ "$id" == "$wanted" && "$item_vault" == "$vault" ]]; then
			printf '%s|%s|%s|%s|%s\n' \
				"$id" "$title" "$item_vault" "$field" "$value" >>"$next"
		else
			printf '%s|%s|%s|%s|%s\n' \
				"$id" "$old_title" "$item_vault" "$old_field" "$old_value" >>"$next"
		fi
	done <"$FAKE_STATE/items"
	mv -- "$next" "$FAKE_STATE/items"
	printf '{"id":"%s"}\n' "$wanted"
	;;
"read "*)
	reference=""
	for argument in "$@"; do
		case "$argument" in
		op://*) reference=$argument ;;
		esac
	done
	without_scheme=${reference#op://}
	vault=${without_scheme%%/*}
	after_vault=${without_scheme#*/}
	wanted=${after_vault%%/*}
	field=${after_vault#*/}
	row=$(find_item "$wanted" "$vault")
	IFS='|' read -r id title item_vault stored_field value <<<"$row"
	[[ "$field" == "$stored_field" ]] || exit 1
	printf '%s' "$value"
	;;
*)
	printf 'unsupported fake op call: %s\n' "$*" >&2
	exit 64
	;;
esac
FAKE_OP

cat >"$fake_bin/security" <<'FAKE_SECURITY'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >>"$FAKE_STATE/security-calls"
case "$*" in
*"flow-icons-zed-premium"*)
	printf '%s\n' "${FAKE_KEYCHAIN_VALUE:-fixture-flow-secret}"
	;;
*"dotfiles-test-token"*)
	printf 'fixture-service-token\n'
	;;
*)
	exit 1
	;;
esac
FAKE_SECURITY

chmod +x "$fake_bin/op" "$fake_bin/security"

render_helper() {
	local profile=$1 vault=$2 output=$3
	local home_dir="$temp_root/home-$profile"
	local config_file="$temp_root/config-$profile.toml"
	mkdir -p "$home_dir"
	cat >"$config_file" <<EOF
[data]
  machineType = "$profile"
  machineName = "ci-$profile"
  gitName = "Dotfiles Test"
  defaultEmail = "test@example.com"
  defaultGitHubUser = "Braden1996"
  opVault = "$vault"
  opTokenKeychainService = "dotfiles-test-token"
EOF
	HOME="$home_dir" \
		"$chezmoi_bin" execute-template \
		--config "$config_file" \
		--destination "$home_dir" \
		--no-tty \
		--source "$repo_root" \
		--file "$repo_root/dot_local/libexec/braden-dots/executable_secret.tmpl" >"$output"
	chmod +x "$output"
}

personal_helper="$temp_root/dotfiles-secrets-personal"
work_helper="$temp_root/dotfiles-secrets-work"
render_helper personal "Personal Vault" "$personal_helper"
render_helper work "Work Vault" "$work_helper"

run_personal() {
	PATH="$fake_bin:$PATH" HOME="$temp_root/home-personal" "$personal_helper" "$@"
}

run_work() {
	PATH="$fake_bin:$PATH" HOME="$temp_root/home-work" "$work_helper" "$@"
}

reset_state

assert_not_contains "$personal_helper" fixture-flow-secret \
	"rendered helper must not contain a secret value"
list_output="$fake_state/list-output"
run_personal list >"$list_output"
assert_contains "$list_output" "flow-icons" "registry should list Flow Icons"
assert_contains "$list_output" "personal,work" \
	"registry should allow Flow Icons on both profiles"
assert_contains "$personal_helper" "Flow Icons License" \
	"registry should use the shared Flow Icons item title"
assert_contains "$personal_helper" "license key" \
	"registry should use the shared Flow Icons field label"

missing_status="$fake_state/missing-status"
if run_personal status flow-icons >"$missing_status" 2>&1; then
	fail "single-secret status should fail while the optional item is absent"
fi
assert_not_contains "$missing_status" fixture-flow-secret \
	"status must never print a secret value"

run_personal set flow-icons \
	--from-keychain flow-icons-zed-premium >/dev/null
[[ "$(wc -l <"$fake_state/items" | tr -d ' ')" == 1 ]] ||
	fail "import should create exactly one item"
assert_contains "$fake_state/items" \
	"Flow Icons License|personal-vault-id|credential|fixture-flow-secret" \
	"import should store the Keychain value in the configured vault"
assert_not_contains "$fake_state/op-calls" fixture-flow-secret \
	"secret value must not appear in op arguments"
assert_not_contains "$fake_state/security-calls" fixture-flow-secret \
	"secret value must not appear in Keychain arguments"

read_value="$(run_personal read flow-icons)"
[[ "$read_value" == fixture-flow-secret ]] ||
	fail "read should print exactly the stored secret"

present_status="$fake_state/present-status"
run_personal status flow-icons >"$present_status"
assert_not_contains "$present_status" fixture-flow-secret \
	"successful status must not print a secret value"

export FAKE_EXPECT_DESKTOP_AUTH_ONLY=1
OP_SERVICE_ACCOUNT_TOKEN=ambient-service-token \
	OP_CONNECT_HOST=https://connect.invalid \
	OP_CONNECT_TOKEN=ambient-connect-token \
	run_personal status flow-icons >/dev/null
unset FAKE_EXPECT_DESKTOP_AUTH_ONLY

export FAKE_KEYCHAIN_VALUE=rotated-flow-secret
run_personal set flow-icons \
	--from-keychain flow-icons-zed-premium >/dev/null
unset FAKE_KEYCHAIN_VALUE
[[ "$(wc -l <"$fake_state/items" | tr -d ' ')" == 1 ]] ||
	fail "rotation should update rather than duplicate the item"
[[ "$(run_personal read flow-icons)" == rotated-flow-secret ]] ||
	fail "rotation should replace the stored value"
assert_not_contains "$fake_state/op-calls" rotated-flow-secret \
	"rotated value must not appear in op arguments"
jq -e '
	.tags == ["existing-tag"] and
	.notesPlain == "keep this note" and
	.urls == [{href: "https://example.test"}] and
	any(.fields[]; .id == "unrelated" and .value == "keep-me")
' "$fake_state/last-edit.json" >/dev/null ||
	fail "rotation should preserve unrelated item metadata and fields"

: >"$fake_state/op-calls"
export FAKE_ITEM_CATEGORY=LOGIN
if run_personal set flow-icons \
	--from-keychain flow-icons-zed-premium >/dev/null 2>&1; then
	fail "a title collision with a non-API item should be rejected"
fi
unset FAKE_ITEM_CATEGORY
assert_not_contains "$fake_state/op-calls" $'item\tedit' \
	"a non-API title collision must not be edited"

: >"$fake_state/op-calls"
: >"$fake_state/security-calls"
if run_personal read unknown >/dev/null 2>&1; then
	fail "unknown aliases must fail"
fi
[[ ! -s "$fake_state/op-calls" && ! -s "$fake_state/security-calls" ]] ||
	fail "unknown aliases must fail before external credential calls"

# A desktop-authenticated personal Mac provisions the independent work-vault
# copy. The work profile can read it, while the helper refuses write commands.
export FAKE_KEYCHAIN_VALUE=work-flow-secret
run_personal set flow-icons --vault "Work Vault" \
	--from-keychain flow-icons-zed-premium >/dev/null
unset FAKE_KEYCHAIN_VALUE
: >"$fake_state/op-calls"
: >"$fake_state/security-calls"
export FAKE_REQUIRE_WORK_SERVICE_AUTH=1
work_value="$(run_work read flow-icons)"
unset FAKE_REQUIRE_WORK_SERVICE_AUTH
[[ "$work_value" == work-flow-secret ]] ||
	fail "work profile should read Flow Icons from its configured vault"
assert_not_contains "$fake_state/op-calls" work-flow-secret \
	"work-vault value must not appear in op arguments"
assert_contains "$fake_state/op-calls" work-vault-id \
	"work Flow reads should resolve and use only the configured work vault"
assert_not_contains "$fake_state/op-calls" personal-vault-id \
	"work Flow reads must not touch the personal vault"

: >"$fake_state/op-calls"
: >"$fake_state/security-calls"
if run_work set flow-icons --vault "Other Vault" \
	--from-keychain flow-icons-zed-premium >/dev/null 2>&1; then
	fail "work service-account profile must reject Flow writes"
fi
[[ ! -s "$fake_state/op-calls" && ! -s "$fake_state/security-calls" ]] ||
	fail "work Flow writes must fail before op or Keychain access"

# A manually created 1Password item may give the labelled field an opaque ID.
# Resolve that ID from metadata instead of placing the space-containing label in
# the secret reference.
printf 'manual-item|Flow Icons License|personal-vault-id|opaque-field-id|manual-flow-secret\n' \
	>"$fake_state/items"
: >"$fake_state/op-calls"
export FAKE_FIELD_LABEL="license key"
[[ "$(run_personal read flow-icons)" == manual-flow-secret ]] ||
	fail "a manually labelled Flow Icons field should be readable"
unset FAKE_FIELD_LABEL
assert_contains "$fake_state/op-calls" \
	"op://personal-vault-id/manual-item/opaque-field-id" \
	"reads should use the resolved 1Password field ID"
assert_not_contains "$fake_state/op-calls" \
	"op://personal-vault-id/manual-item/license key" \
	"space-containing field labels must not be placed in secret references"

printf 'braden-dots secret tests passed\n'
